function changePlayerNation(pIdx, nationId) {
  setupState.players[pIdx].nation = nationId;
  const nationShips = SHIPS_DB.filter(s => s.nation === nationId);
  const limit = getEffectiveCostLimit(pIdx);
  const newFleet = [];
  let sum = 0;
  for (const s of nationShips) {
    if (sum + s.cost <= limit && newFleet.length < 5) {
      newFleet.push(s.id);
      sum += s.cost;
    }
  }
  setupState.players[pIdx].fleet = newFleet;
  renderSetupPanels();
}

function togglePlayerAI(pIdx) {
  setupState.players[pIdx].isAI = !setupState.players[pIdx].isAI;
  renderSetupPanels();
}

function addShipToFleet(pIdx, shipId) {
  const p = setupState.players[pIdx];
  const ship = SHIPS_DB.find(s => s.id === shipId);
  if (!ship) return;
  if (!setupState.allowDuplicateShips && p.fleet.includes(shipId)) {
    showBanner(`🚫 同名艦「${ship.name}」は1艦隊に1隻までしか編入できません！`);
    return;
  }
  const limit = getEffectiveCostLimit(pIdx);
  if (getFleetCost(p.fleet) + ship.cost > limit) {
    showBanner('コスト上限を超えています！');
    return;
  }
  p.fleet.push(shipId);
  renderSetupPanels();
}

function removeShipFromFleet(pIdx, idxInFleet) {
  setupState.players[pIdx].fleet.splice(idxInFleet, 1);
  renderSetupPanels();
}

function autoFillFleet(pIdx) {
  const p = setupState.players[pIdx];
  const limit = getEffectiveCostLimit(pIdx);
  const pool = SHIPS_DB.filter(s => s.nation === p.nation);
  p.fleet = [];
  let guard = 0;
  while (getFleetCost(p.fleet) < limit && guard < 40) {
    guard++;
    const rem = limit - getFleetCost(p.fleet);
    const candidates = pool.filter(s => s.cost <= rem && (setupState.allowDuplicateShips || !p.fleet.includes(s.id)));
    if (candidates.length === 0) break;
    const pick = candidates[Math.floor(Math.random() * candidates.length)];
    p.fleet.push(pick.id);
  }
  renderSetupPanels();
}

