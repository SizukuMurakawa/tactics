let gameState = null;

// Grid cell types: 0 = Deep Sea, 1 = Island, 2 = Shoal (浅瀬), 3 = Control Point [★]
function generateMap(stage) {
  const g = Array.from({ length: BOARD_SIZE }, () => Array(BOARD_SIZE).fill(0));
  g[5][5] = 3; g[5][6] = 3; g[6][5] = 3; g[6][6] = 3;

  if (stage === 'standard') {
    const islands = [[3,3],[3,4],[8,7],[8,8],[4,8],[7,3]];
    islands.forEach(([r,c]) => g[r][c] = 1);
    const shoals = [[3,5],[8,6],[5,3],[6,8]];
    shoals.forEach(([r,c]) => g[r][c] = 2);
  } else if (stage === 'fortress') {
    const islands = [[3,2],[3,3],[3,8],[3,9],[8,2],[8,3],[8,8],[8,9],[5,3],[6,8]];
    islands.forEach(([r,c]) => g[r][c] = 1);
    const shoals = [[4,4],[4,7],[7,4],[7,7]];
    shoals.forEach(([r,c]) => g[r][c] = 2);
  } else if (stage === 'strait') {
    for (let c = 0; c < BOARD_SIZE; c++) {
      if (c < 4 || c > 7) {
        g[5][c] = 1;
        g[6][c] = 1;
      }
    }
    g[5][4] = 2; g[6][7] = 2;
  } else if (stage === 'coral') {
    const islands = [[2,4],[2,7],[4,2],[4,9],[7,2],[7,9],[9,4],[9,7]];
    islands.forEach(([r,c]) => g[r][c] = 1);
    const shoals = [[3,4],[3,5],[3,6],[3,7],[8,4],[8,5],[8,6],[8,7],[5,4],[6,7]];
    shoals.forEach(([r,c]) => g[r][c] = 2);
  } else if (stage === 'triangle') {
    const islands = [[4,5],[4,6],[7,4],[7,7]];
    islands.forEach(([r,c]) => g[r][c] = 1);
    const shoals = [[5,4],[5,7],[7,5],[7,6]];
    shoals.forEach(([r,c]) => g[r][c] = 2);
  }
  return g;
}

function getSpawnCoords(pIdx, count, mode) {
  if (mode === '1v1_ai' || mode === '1v1_pvp') {
    if (pIdx === 0) return [[1,2],[1,3],[1,8],[1,9],[2,3],[2,4],[2,7],[2,8]];
    return [[10,2],[10,3],[10,8],[10,9],[9,3],[9,4],[9,7],[9,8]];
  }
  if (mode === '1v2_hard') {
    if (pIdx === 0) return [[1,2],[1,3],[1,8],[1,9],[2,3],[2,4],[2,7],[2,8]];
    if (pIdx === 1) return [[10,1],[10,2],[10,3],[9,2],[9,3],[9,4]];
    return [[10,8],[10,9],[10,10],[9,7],[9,8],[9,9]];
  }
  if (mode === '1v1v1_ai' || mode === '1v1v1_pvp') {
    if (pIdx === 0) return [[1,1],[1,2],[2,1],[2,2],[1,3],[2,3]];
    if (pIdx === 1) return [[1,10],[1,9],[2,10],[2,9],[1,8],[2,8]];
    return [[10,4],[10,7],[9,4],[9,5],[9,6],[9,7]];
  }
  if (pIdx === 0) return [[1,1],[1,2],[2,1],[2,2],[1,3],[2,3]];
  if (pIdx === 1) return [[1,10],[1,9],[2,10],[2,9],[1,8],[2,8]];
  if (pIdx === 2) return [[10,1],[10,2],[9,1],[9,2],[10,3],[9,3]];
  return [[10,10],[10,9],[9,10],[9,9],[10,8],[9,8]];
}

function getInitialDir(pIdx, mode) {
  if (mode === '1v1_ai' || mode === '1v1_pvp') return pIdx === 0 ? 4 : 0;
  if (mode === '1v2_hard') return pIdx === 0 ? 4 : 0;
  if (mode === '1v1v1_ai' || mode === '1v1v1_pvp') {
    if (pIdx === 0) return 3;
    if (pIdx === 1) return 5;
    return 0;
  }
  if (pIdx === 0) return 3;
  if (pIdx === 1) return 5;
  if (pIdx === 2) return 1;
  return 7;
}

function startGame() {
  const count = getActivePlayerCount();
  for (let i = 0; i < count; i++) {
