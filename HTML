        ownerId: southOwner.id,
        team: 'B',
        nation: southOwner.nation,
        isPlane: false,
        isFortress: true,
        shipId: 'fortress_hq',
        name: '南司令部要塞',
        type: 'HQ',
        cost: 10,
        hp: 25,
        maxHp: 25,
        move: 0,
        range: 3,
        guns: 2,
        torp: 0,
        maxTorp: 0,
        torpDmg: 0,
        skillName: '沿岸要塞砲＆港湾ドック',
        skillDesc: 'R終了時に周囲3マスの敵へ自動砲撃(2ダメ)＆周囲2マスの味方艦をHP+1修理。',
        x: 5,
        y: 10,
        dir: 0,
        submerged: false,
        acted: true
      });
    }
  }

  function findFreeSpawnTile(preferredCoords, fallbackRow) {
    for (const [ry, cx] of preferredCoords) {
      if (ry >= 0 && ry < BOARD_SIZE && cx >= 0 && cx < BOARD_SIZE) {
        if (mapGrid[ry][cx] !== 1 && !units.some(u => !u.isPlane && u.x === cx && u.y === ry)) {
          return [ry, cx];
        }
      }
    }
    for (let dist = 0; dist < BOARD_SIZE; dist++) {
      for (const rOffset of [dist, -dist]) {
        const ry = fallbackRow + rOffset;
        if (ry < 0 || ry >= BOARD_SIZE) continue;
        for (let cx = 0; cx < BOARD_SIZE; cx++) {
          if (mapGrid[ry][cx] !== 1 && !units.some(u => !u.isPlane && u.x === cx && u.y === ry)) {
            return [ry, cx];
          }
        }
      }
    }
    return [fallbackRow, 0];
  }

  for (let i = 0; i < count; i++) {
    const sp = setupState.players[i];
    activePlayers.push({
      id: sp.id,
      name: sp.name,
      nation: sp.nation,
      isAI: sp.isAI,
      team: sp.team,
      vp: 0,
      ukTurnUsedThisTurn: false
    });

    const spawns = getSpawnCoords(i, count, setupState.mode);
    const dir = getInitialDir(i, setupState.mode);
    const fallbackRow = spawns[0] ? spawns[0][0] : (sp.team === 'A' ? 1 : 10);

    sp.fleet.forEach((shipId, idx) => {
      const tmpl = SHIPS_DB.find(s => s.id === shipId);
      if (!tmpl) return;
      const orderedSpawns = [...spawns.slice(idx % spawns.length), ...spawns.slice(0, idx % spawns.length)];
      const coord = findFreeSpawnTile(orderedSpawns, fallbackRow);
      units.push({
        uid: `u_${uidCounter++}`,
        ownerId: sp.id,
        team: sp.team,
        nation: sp.nation,
        isPlane: false,
        shipId: tmpl.id,
        name: tmpl.name,
        type: tmpl.type,
        cost: tmpl.cost,
        hp: tmpl.hp,
        maxHp: tmpl.hp,
        move: tmpl.move,
        range: tmpl.range,
        guns: tmpl.guns,
        torp: tmpl.torp,
        maxTorp: tmpl.torp,
        torpDmg: tmpl.torpDmg,
        maxPlanes: tmpl.maxPlanes || 0,
        planesRemaining: tmpl.maxPlanes || 0,
        skillName: tmpl.skillName,
        skillDesc: tmpl.skillDesc,
        x: coord[1],
        y: coord[0],
        dir: dir,
        submerged: tmpl.type === 'SS',
        acted: false,
        movedThisTurn: false,
        stepsMoved: 0,
        grounded: false,
        rudderDamaged: false,
        luckyUsed: false,
        bismarckUsed: false,
        aaShieldUsed: false,
        entRevives: tmpl.id === 'us_cv1' ? 2 : 0,
        launchedThisTurn: 0
      });
    });
  }

  const maxRounds = setupState.maxRounds;
  const roundLimitLabel = maxRounds > 0 ? `最大${maxRounds}R` : 'ラウンド無制限';
  const diffCfg = getAiDiffConfig(setupState.aiDifficulty);

  gameState = {
    round: 1,
    maxRounds: maxRounds,
    targetVp: isAnyFortressMode() ? 0 : setupState.targetVp,
    battleFormat: setupState.battleFormat,
    mode: setupState.mode,
    stage: setupState.stage,
    aiSpeed: setupState.aiSpeed,
    aiDifficulty: setupState.aiDifficulty,
    grid: mapGrid,
    players: activePlayers,
    turnPlayerIdx: 0,
    weather: WEATHER_TABLE[3],
    units: units,
    selectedUid: null,
    modeAction: 'MOVE',
    gameOver: false
  };

  if (isAnyFortressMode()) {
    gameState.grid[1][6] = 1;
    if (isDualFortressMode()) {
      gameState.grid[10][6] = 1;
    }
  }

  document.getElementById('setup-screen').classList.add('hidden');
  document.getElementById('game-screen').classList.remove('hidden');
  document.getElementById('battle-log').innerHTML = '';

  rollWeather();
  const vpRuleText = isSingleFortressMode()
    ? `🏰 北司令部要塞(HP25)を${maxRounds}ラウンド防衛すれば北軍勝利！`
    : (isDualFortressMode()
        ? `🏰 先に敵の司令部要塞(HP25)を破壊した陣営が勝利（${roundLimitLabel}）！`
        : (gameState.targetVp > 0 ? `${gameState.targetVp}pt先取（${roundLimitLabel}）` : `敵艦隊全滅（${roundLimitLabel}）`));
  addLog(`⚓ 海戦開始！勝利条件: ${vpRuleText} / AI強さ: ${diffCfg.label} / ステージ: ${document.getElementById('stage-select').selectedOptions[0].text}`, 'text-amber-300 font-bold');

  resizeCanvas();
  startPlayerTurn();
}

function rollWeather() {
  const d1 = Math.floor(Math.random() * 6) + 1;
  const d2 = Math.floor(Math.random() * 6) + 1;
  const sum = d1 + d2;
  const w = WEATHER_TABLE.find(x => sum >= x.min && sum <= x.max) || WEATHER_TABLE[3];
  gameState.weather = w;
  addLog(`🎲 [R${gameState.round} 天候判定: 2D6=${sum}] ${w.name} — ${w.desc}`, 'text-sky-300');

  if (w.name.includes('スコール')) {
    const planes = gameState.units.filter(u => u.isPlane && u.hp > 0);
    if (planes.length > 0) {
      planes.forEach(pl => {
        const cv = gameState.units.find(u => u.uid === pl.parentCvUid && u.hp > 0);
        if (cv) cv.planesRemaining = Math.min(cv.maxPlanes, cv.planesRemaining + 1);
      });
      gameState.units = gameState.units.filter(u => !u.isPlane);
      addLog(`🌧️ スコール発生により全艦載機が母艦へ緊急帰還しました！`, 'text-sky-200');
    }
  }
}

function getCurrentPlayer() {
  return gameState.players[gameState.turnPlayerIdx];
}

function startPlayerTurn() {
  if (gameState.gameOver) return;
  gameState.units = gameState.units.filter(u => u.hp > 0);
  const p = getCurrentPlayer();
  p.ukTurnUsedThisTurn = false;

  gameState.units.forEach(u => {
    if (u.ownerId === p.id) {
      u.acted = u.isFortress ? true : false;
      u.movedThisTurn = false;
      u.stepsMoved = 0;
      u.aaShieldUsed = false;
      u.launchedThisTurn = 0;
      if (u.type === 'SS' && !u.submerged && u.hp > 0) {
        u.submerged = true;
        addLog(`🫧 ${u.name} が再び潜航状態に移行しました。`, 'text-cyan-300');
      }
      if (u.grounded) {
        u.grounded = false;
        u.acted = true;
        addLog(`⚠️ ${u.name} は浅瀬から離礁作業中のため今ターン行動不能！`, 'text-amber-400');
      }
    }
  });

  const firstReady = gameState.units.find(u => u.ownerId === p.id && !u.acted && !u.isFortress && u.hp > 0);
  gameState.selectedUid = firstReady ? firstReady.uid : null;
  gameState.modeAction = 'MOVE';

  updateHUD();
  renderInspector();
  renderActionControls();
  drawCanvas();

  if (p.isAI) {
    setTimeout(() => runAITurnStep(), gameState.aiSpeed);
  }
}

function advanceTurn() {
  if (gameState.gameOver) return;
  gameState.units = gameState.units.filter(u => u.hp > 0);
  checkVictoryConditions();
  if (gameState.gameOver) return;

  const p = getCurrentPlayer();
  const nextUnit = gameState.units.find(u => u.ownerId === p.id && !u.acted && !u.isFortress && u.hp > 0);
  if (nextUnit) {
    gameState.selectedUid = nextUnit.uid;
    updateHUD();
    renderInspector();
    renderActionControls();
    drawCanvas();
    if (p.isAI) {
      setTimeout(() => runAITurnStep(), gameState.aiSpeed);
    }
    return;
  }

  gameState.turnPlayerIdx++;
  if (gameState.turnPlayerIdx >= gameState.players.length) {
    gameState.turnPlayerIdx = 0;
    endRound();
  } else {
    startPlayerTurn();
  }
}

function endRound() {
  if (gameState.gameOver) return;
  gameState.units = gameState.units.filter(u => u.hp > 0);

  // Fortress Coastal Guns & Harbor Dock Repairs
  const fortresses = gameState.units.filter(u => u.isFortress && u.hp > 0);
  fortresses.forEach(hq => {
    gameState.units.forEach(ally => {
      if (!ally.isPlane && !ally.isFortress && ally.team === hq.team && ally.hp > 0 && ally.hp < ally.maxHp) {
        const d = Math.max(Math.abs(ally.x - hq.x), Math.abs(ally.y - hq.y));
        if (d <= 2) {
          ally.hp = Math.min(ally.maxHp, ally.hp + 1);
          addLog(`🔧 [${hq.name} 港湾ドック] ${ally.name} の耐久が1回復 (${ally.hp}/${ally.maxHp})`, 'text-emerald-300');
        }
      }
    });

    const nearbyEnemies = gameState.units.filter(en => !en.isPlane && en.team !== hq.team && en.hp > 0 && !en.submerged && Math.max(Math.abs(en.x - hq.x), Math.abs(en.y - hq.y)) <= 3);
    if (nearbyEnemies.length > 0) {
      const target = nearbyEnemies[0];
      target.hp = Math.max(0, target.hp - 2);
      addLog(`🏰 [${hq.name} 沿岸砲] 接近した ${target.name} に援護砲撃 2ダメージ！(残HP:${target.hp})`, 'text-amber-300 font-bold');
      if (target.hp <= 0) handleUnitSunk(hq, target);
    }
  });

  // Control Point VP scoring in standard mode
  if (!isAnyFortressMode() && gameState.targetVp > 0) {
    const teamShipsInCenter = {};
    gameState.units.forEach(u => {
      if (!u.isPlane && !u.isFortress && u.hp > 0 && !u.submerged && gameState.grid[u.y][u.x] === 3) {
        teamShipsInCenter[u.team] = (teamShipsInCenter[u.team] || 0) + 1;
      }
    });
    const teamsPresent = Object.keys(teamShipsInCenter);
    if (teamsPresent.length === 1) {
      const winTeam = teamsPresent[0];
      gameState.players.forEach(pl => {
        if (pl.team === winTeam) pl.vp += 1;
      });
      addLog(`🏅 [制海権確保] ${winTeam}陣営が中央海域[★]を単独制圧！+1pt獲得！`, 'text-amber-300 font-bold');
    }
  }

  // Planes return to carriers/subs at end of round
  const planes = gameState.units.filter(u => u.isPlane && u.hp > 0);
  if (planes.length > 0) {
    planes.forEach(pl => {
      const cv = gameState.units.find(u => u.uid === pl.parentCvUid && u.hp > 0);
      if (cv) {
        cv.planesRemaining = Math.min(cv.maxPlanes, cv.planesRemaining + 1);
      }
    });
    gameState.units = gameState.units.filter(u => !u.isPlane);
    addLog(`🛬 ラウンド終了に伴い、飛行中の艦載機が母艦へ帰還しました。`, 'text-sky-300');
  }

  // Reset rudder damage
  gameState.units.forEach(u => { u.rudderDamaged = false; });

  checkVictoryConditions();
  if (gameState.gameOver) return;

  if (gameState.maxRounds > 0 && gameState.round >= gameState.maxRounds) {
    finishGameByRounds();
    return;
  }

  gameState.round++;
  rollWeather();
  startPlayerTurn();
}

function finishGameByRounds() {
  gameState.gameOver = true;
  if (isSingleFortressMode()) {
    const northHq = gameState.units.find(u => u.uid === 'fortress_north');
    if (northHq && northHq.hp > 0) {
      showGameOverModal('🏆 北軍（防衛側）の勝利！', `最終ラウンド(${gameState.maxRounds}R)まで北司令部要塞(残HP:${northHq.hp}/25)を守り抜きました！`);
    } else {
      showGameOverModal('💥 南軍（強襲側）の勝利！', '北司令部要塞を陥落させました！');
    }
    return;
  }
  if (isDualFortressMode()) {
    const northHq = gameState.units.find(u => u.uid === 'fortress_north');
    const southHq = gameState.units.find(u => u.uid === 'fortress_south');
    const nHp = northHq ? northHq.hp : 0;
    const sHp = southHq ? southHq.hp : 0;
    if (nHp > sHp) {
      showGameOverModal('🏆 北軍（A陣営）の勝利！', `最終ラウンド終了時の要塞耐久判定（北要塞 HP:${nHp} vs 南要塞 HP:${sHp}）で北軍が勝利しました！`);
    } else if (sHp > nHp) {
      showGameOverModal('🏆 南軍（B陣営）の勝利！', `最終ラウンド終了時の要塞耐久判定（南要塞 HP:${sHp} vs 北要塞 HP:${nHp}）で南軍が勝利しました！`);
    } else {
      showGameOverModal('⚖️ 引き分け！', `両軍の司令部要塞耐久が同値（HP:${nHp}）で時間切れとなりました。`);
    }
    return;
  }

  const sorted = [...gameState.players].sort((a, b) => b.vp - a.vp);
  const top = sorted[0];
  showGameOverModal(`🏆 ${top.team}陣営 (${top.name}) の勝利！`, `最終ラウンド(${gameState.maxRounds}R)終了！獲得ポイント ${top.vp}pt で勝利を収めました！`);
}

function checkVictoryConditions() {
  if (gameState.gameOver) return;

  if (isSingleFortressMode()) {
    const northHq = gameState.units.find(u => u.uid === 'fortress_north');
    if (!northHq || northHq.hp <= 0) {
      gameState.gameOver = true;
      showGameOverModal('💥 南軍（強襲側）の勝利！', '北司令部要塞が陥落しました！');
      return;
    }
    const southShips = gameState.units.filter(u => !u.isPlane && !u.isFortress && u.team === 'B' && u.hp > 0);
    if (southShips.length === 0) {
      gameState.gameOver = true;
      showGameOverModal('🏆 北軍（防衛側）の勝利！', '南軍の強襲艦隊を全滅させ、要塞を守り抜きました！');
      return;
    }
    return;
  }

  if (isDualFortressMode()) {
    const northHq = gameState.units.find(u => u.uid === 'fortress_north');
    const southHq = gameState.units.find(u => u.uid === 'fortress_south');
    if (!northHq || northHq.hp <= 0) {
      gameState.gameOver = true;
      showGameOverModal('🏆 南軍（B陣営）の勝利！', '北司令部要塞を撃破・陥落させました！');
      return;
    }
    if (!southHq || southHq.hp <= 0) {
      gameState.gameOver = true;
      showGameOverModal('🏆 北軍（A陣営）の勝利！', '南司令部要塞を撃破・陥落させました！');
      return;
    }
    return;
  }

  // Standard Mode: check target VP
  if (gameState.targetVp > 0) {
    const vpWinner = gameState.players.find(p => p.vp >= gameState.targetVp);
    if (vpWinner) {
      gameState.gameOver = true;
      showGameOverModal(`🏆 ${vpWinner.team}陣営 (${vpWinner.name}) の勝利！`, `目標ポイント（${gameState.targetVp}pt）に到達しました！`);
      return;
    }
  }

  // Check fleet annihilation
  const aliveTeams = new Set();
  gameState.units.forEach(u => {
    if (!u.isPlane && !u.isFortress && u.hp > 0) aliveTeams.add(u.team);
  });
  if (aliveTeams.size === 1) {
    const winTeam = Array.from(aliveTeams)[0];
    const winner = gameState.players.find(p => p.team === winTeam);
    gameState.gameOver = true;
    showGameOverModal(`🏆 ${winTeam}陣営 (${winner ? winner.name : ''}) の完全勝利！`, '敵艦隊をすべて撃沈しました！');
  } else if (aliveTeams.size === 0) {
    gameState.gameOver = true;
    showGameOverModal('⚖️ 両軍全滅・引き分け', '壮絶な相打ちとなりました。');
  }
}

// ==========================================
// 4. MOVEMENT, LINE OF SIGHT & COMBAT CALCULATION
// ==========================================
function getEffectiveMove(u) {
  if (u.isFortress) return 0;
  let m = u.move;
  if (u.isPlane) {
    if (u.parentCvUid) {
      const cv = gameState.units.find(x => x.uid === u.parentCvUid);
      if (cv && cv.shipId === 'us_cv2') m += 1;
    }
    return m;
  }
  const w = gameState.weather.name;
  if (w.includes('追い風')) m += 1;
  if (u.nation === 'IT' && (w.includes('晴天') || w.includes('追い風') || w.includes('夜間'))) m += 1;
  if (u.nation === 'NL' && (w.includes('夜間') || w.includes('濃霧') || w.includes('スコール'))) m += 1;
  if (u.shipId === 'it_dd1' && (w.includes('追い風') || w.includes('晴天'))) m += 1;

  // Aura buffs
  gameState.units.forEach(ally => {
    if (ally.uid !== u.uid && ally.team === u.team && ally.hp > 0 && !ally.isPlane) {
      const dist = Math.max(Math.abs(ally.x - u.x), Math.abs(ally.y - u.y));
      if (dist <= 2) {
        if (ally.shipId === 'jp_cl1' && u.type === 'DD') m += 1;
        if (ally.shipId === 'es_cl2' && u.nation === 'ES') m += 1;
        if (ally.shipId === 'nl_cl4' && u.nation === 'NL' && u.type === 'DD') m += 1;
      }
    }
  });

  if (u.type === 'SS' && !u.submerged) m += 1;
  if (u.rudderDamaged) m = Math.max(1, Math.floor(m / 2));
  return m;
}

function getEffectiveRange(u) {
  if (u.isPlane) return 1;
  if (u.type === 'SS' && u.submerged) return 0;
  let r = u.range;
  if (r <= 0) return 0;
  const w = gameState.weather.name;
  const ignoreWeather = u.nation === 'SU' || u.shipId === 'us_bb2' || u.shipId === 'uk_ca1' || u.shipId === 'uk_dd1' || u.shipId === 'au_ca2';
  if (!ignoreWeather) {
    if (w.includes('スコール')) r = Math.max(1, r - 2);
    if (w.includes('夜間')) r = Math.max(1, Math.ceil(r / 2));
  }
  return r;
}

function getEffectiveTorpRange(u) {
  let r = 4;
  if (u.nation === 'JP' && u.type === 'DD') r = 5;
  if (u.shipId === 'jp_ss1' || u.shipId === 'jp_ss_i400') r = 5;
  return r;
}

function hasLineOfSight(x1, y1, x2, y2) {
  const dx = Math.abs(x2 - x1);
  const dy = Math.abs(y2 - y1);
  const steps = Math.max(dx, dy);
  if (steps <= 1) return true;
  for (let i = 1; i < steps; i++) {
    const cx = Math.round(x1 + ((x2 - x1) * i) / steps);
    const cy = Math.round(y1 + ((y2 - y1) * i) / steps);
    if (gameState.grid[cy][cx] === 1) return false;
  }
  return true;
}

// Step-by-step 1-tile movement options (including 1-tile astern / reverse maneuver!)
function getStepMoveOptions(u) {
  if (!u || u.acted || u.isFortress || u.hp <= 0) return [];
  const maxSteps = getEffectiveMove(u);
  const used = u.stepsMoved || 0;
  const rem = maxSteps - used;
  if (rem <= 0) return [];

  const results = [];
  if (u.isPlane) {
    for (let dir = 0; dir < 8; dir++) {
      const nx = u.x + DIRS[dir].dx;
      const ny = u.y + DIRS[dir].dy;
      if (nx < 0 || nx >= BOARD_SIZE || ny < 0 || ny >= BOARD_SIZE) continue;
      const samePlane = gameState.units.find(o => o.hp > 0 && o.isPlane && o.team === u.team && o.x === nx && o.y === ny);
      if (!samePlane) {
        results.push({ x: nx, y: ny, dir: dir, stepCost: 1, isReverse: false });
      }
    }
    return results;
  }

  // Forward & 45-degree turns
  for (const turn of [-1, 0, 1]) {
    const ndir = (u.dir + turn + 8) % 8;
    const nx = u.x + DIRS[ndir].dx;
    const ny = u.y + DIRS[ndir].dy;
    if (nx < 0 || nx >= BOARD_SIZE || ny < 0 || ny >= BOARD_SIZE) continue;
    const cell = gameState.grid[ny][nx];
    if (cell === 1) continue;

    const blocker = gameState.units.find(o => !o.isPlane && o.hp > 0 && o.x === nx && o.y === ny);
    if (blocker) continue;

    const isShoal = cell === 2;
    const canPassShoal = u.type === 'DD' || u.shipId === 'uk_ss1' || u.shipId === 'nl_bb1' || u.shipId === 'nl_ss2';
    const stepCost = (isShoal && !canPassShoal) ? rem : 1;
    results.push({ x: nx, y: ny, dir: ndir, stepCost, isReverse: false });
  }

  // Astern (1 tile directly backward, keeping heading)
  const backDir = (u.dir + 4) % 8;
  const bx = u.x + DIRS[backDir].dx;
  const by = u.y + DIRS[backDir].dy;
  if (bx >= 0 && bx < BOARD_SIZE && by >= 0 && by < BOARD_SIZE) {
    const cell = gameState.grid[by][bx];
    const blocker = gameState.units.find(o => !o.isPlane && o.hp > 0 && o.x === bx && o.y === by);
    if (cell !== 1 && !blocker) {
      const isShoal = cell === 2;
      const canPassShoal = u.type === 'DD' || u.shipId === 'uk_ss1' || u.shipId === 'nl_bb1' || u.shipId === 'nl_ss2';
      const stepCost = (isShoal && !canPassShoal) ? rem : 1;
      results.push({ x: bx, y: by, dir: u.dir, stepCost, isReverse: true });
    }
  }

  return results;
}

function getValidMoves(u) {
  if (!u || u.acted || u.isFortress || u.hp <= 0) return [];
  const maxSteps = getEffectiveMove(u);
  const results = [];

  if (u.isPlane) {
    for (let y = 0; y < BOARD_SIZE; y++) {
      for (let x = 0; x < BOARD_SIZE; x++) {
        if (x === u.x && y === u.y) continue;
        const dist = Math.max(Math.abs(x - u.x), Math.abs(y - u.y));
        if (dist <= maxSteps) {
          const samePlane = gameState.units.find(o => o.hp > 0 && o.isPlane && o.team === u.team && o.x === x && o.y === y);
          if (!samePlane) results.push({ x, y, dir: u.dir, path: [{ x, y }] });
        }
      }
    }
    return results;
  }

  const visited = new Map();
  const queue = [{ x: u.x, y: u.y, dir: u.dir, steps: 0, path: [] }];
  visited.set(`${u.x},${u.y},${u.dir}`, 0);

  while (queue.length > 0) {
    const cur = queue.shift();
    if (cur.steps > 0) {
      results.push({ x: cur.x, y: cur.y, dir: cur.dir, path: cur.path });
    }
    if (cur.steps >= maxSteps) continue;

    for (const turn of [-1, 0, 1]) {
      const ndir = (cur.dir + turn + 8) % 8;
      const nx = cur.x + DIRS[ndir].dx;
      const ny = cur.y + DIRS[ndir].dy;
      if (nx < 0 || nx >= BOARD_SIZE || ny < 0 || ny >= BOARD_SIZE) continue;
      const cell = gameState.grid[ny][nx];
      if (cell === 1) continue;

      const blocker = gameState.units.find(o => !o.isPlane && o.hp > 0 && o.x === nx && o.y === ny);
      if (blocker) continue;

      const isShoal = cell === 2;
      const canPassShoal = u.type === 'DD' || u.shipId === 'uk_ss1' || u.shipId === 'nl_bb1' || u.shipId === 'nl_ss2';
      const nextSteps = isShoal && !canPassShoal ? maxSteps : cur.steps + 1;
      const key = `${nx},${ny},${ndir}`;
      if (!visited.has(key) || visited.get(key) > nextSteps) {
        visited.set(key, nextSteps);
        queue.push({ x: nx, y: ny, dir: ndir, steps: nextSteps, path: [...cur.path, { x: nx, y: ny }] });
      }
    }
  }

  const byCoord = new Map();
  for (const r of results) {
    const ck = `${r.x},${r.y}`;
    if (!byCoord.has(ck)) byCoord.set(ck, r);
  }
  return Array.from(byCoord.values());
}

function getAttackableTargets(u) {
  if (!u || u.acted || u.isFortress || u.hp <= 0) return [];
  const targets = [];
  const w = gameState.weather.name;

  if (u.isPlane) {
    if (u.role === 'RECON') return [];
    gameState.units.forEach(en => {
      if (en.team === u.team || en.hp <= 0) return;
      const dist = Math.max(Math.abs(en.x - u.x), Math.abs(en.y - u.y));
      if (en.isPlane) {
        if ((u.role === 'FIGHTER' || u.role === 'MULTI') && dist <= 1) {
          targets.push({ unit: en, weapon: 'DOGFIGHT', label: '✈️ 空戦迎撃' });
        }
      } else {
        if (en.submerged) return;
        const maxAirDist = u.planeId === 'tbf' ? 2 : 1;
        if (dist <= maxAirDist) {
          if (u.role === 'BOMBER' || u.role === 'TORPEDO' || u.role === 'MULTI' || u.planeId === 'shiden' || u.planeId === 'me155') {
            targets.push({ unit: en, weapon: 'AIRSTRIKE', label: '💣 航空攻撃' });
          }
        }
      }
    });
    return targets;
  }

  const gunRange = getEffectiveRange(u);
  const torpRange = getEffectiveTorpRange(u);

  gameState.units.forEach(en => {
    if (en.isPlane || en.team === u.team || en.hp <= 0) return;
    const dist = Math.max(Math.abs(en.x - u.x), Math.abs(en.y - u.y));

    if (en.submerged) {
      if ((u.type === 'DD' || u.type === 'CL') && dist <= 2) {
        targets.push({ unit: en, weapon: 'DEPTH_CHARGE', label: '💣 爆雷投下' });
      }
      return;
    }

    if (w.includes('濃霧') && en.type === 'DD' && dist > 2) return;

    if (gunRange > 0 && dist <= gunRange && hasLineOfSight(u.x, u.y, en.x, en.y)) {
      targets.push({ unit: en, weapon: 'GUN', label: '💥 主砲斉射' });
    }

    if (u.torp > 0 && dist <= torpRange && hasLineOfSight(u.x, u.y, en.x, en.y)) {
      targets.push({ unit: en, weapon: 'TORPEDO', label: '🔱 魚雷発射' });
    }
  });

  return targets;
}

function getRelativeAngleType(attacker, defender) {
  const vx = attacker.x - defender.x;
  const vy = attacker.y - defender.y;
  const f = DIRS[defender.dir];
  const dot = vx * f.dx + vy * f.dy;
  const lenV = Math.hypot(vx, vy) || 1;
  const lenF = Math.hypot(f.dx, f.dy) || 1;
  const cos = dot / (lenV * lenF);
  if (cos > 0.5) return 'BOW';
  if (cos < -0.5) return 'STERN';
  return 'BROADSIDE';
}

function executeMove(u, moveObj) {
  u.x = moveObj.x;
  u.y = moveObj.y;
  u.dir = moveObj.dir;
  u.stepsMoved = (u.stepsMoved || 0) + (moveObj.stepCost || 1);
  const maxSteps = getEffectiveMove(u);
  if (u.stepsMoved >= maxSteps) {
    u.movedThisTurn = true;
  }

  if (!u.isPlane) {
    const cell = gameState.grid[u.y][u.x];
    const canPassShoal = u.type === 'DD' || u.shipId === 'uk_ss1' || u.shipId === 'nl_bb1' || u.shipId === 'nl_ss2';
    if (cell === 2 && !canPassShoal) {
      u.grounded = true;
      u.movedThisTurn = true;
      u.acted = true;
      addLog(`⚠️ ${u.name} が浅瀬に座礁！次ターン行動不能になります！`, 'text-amber-400 font-bold');
    }

    if (u.type === 'DD' || u.type === 'CL' || u.shipId === 'jp_ca2' || u.shipId === 'uk_cl1') {
      const detectRange = (u.shipId === 'jp_ca2' || u.shipId === 'uk_cl1') ? 3 : 2;
      gameState.units.forEach(en => {
        if (!en.isPlane && en.team !== u.team && en.submerged && en.hp > 0) {
          const d = Math.max(Math.abs(en.x - u.x), Math.abs(en.y - u.y));
          if (d <= detectRange) {
            en.submerged = false;
            addLog(`📡 [ソナー探知] ${u.name} が潜航中の ${en.name} を発見・強制浮上させた！`, 'text-cyan-300 font-bold');
          }
        }
      });
    }
  } else if (u.role === 'RECON') {
    gameState.units.forEach(en => {
      if (!en.isPlane && en.team !== u.team && en.submerged && en.hp > 0) {
        const d = Math.max(Math.abs(en.x - u.x), Math.abs(en.y - u.y));
        if (d <= 3) {
          en.submerged = false;
          addLog(`📡 [${u.name} 航空偵察] 潜航中の ${en.name} を発見・強制浮上させた！`, 'text-cyan-300 font-bold');
        }
      }
    });
    if (u.movedThisTurn) {
      addLog(`📡 ${u.name} が偵察飛行を完了しました。`, 'text-sky-300');
      u.acted = true;
      advanceTurn();
      return;
    }
  }

  const remSteps = Math.max(0, maxSteps - u.stepsMoved);
  const moveVerb = moveObj.isReverse ? 'へ後進（微速後退）' : 'へ1マス前進';
  addLog(`🚢 ${u.name} が (${u.x + 1}, ${u.y + 1}) ${moveVerb}（残移動:${remSteps}）。`, 'text-slate-300');

  if (u.acted) {
    advanceTurn();
  } else {
    renderInspector();
    renderActionControls();
    drawCanvas();
  }
}

function executeAttack(attacker, attackInfo) {
  const target = attackInfo.unit;
  if (!attacker || !target || attacker.hp <= 0 || target.hp <= 0) {
    if (attacker) attacker.acted = true;
    advanceTurn();
    return;
  }
  const weapon = attackInfo.weapon;
  const dist = Math.max(Math.abs(target.x - attacker.x), Math.abs(target.y - attacker.y));
  const w = gameState.weather.name;

  // Check if attacker belongs to an AI player and apply difficulty hit modifier
  const attackerOwner = gameState.players.find(p => p.id === attacker.ownerId);
  const aiHitMod = (attackerOwner && attackerOwner.isAI) ? getAiDiffConfig().hitMod : 0;

  if (target.shipId === 'jp_dd1' && !target.luckyUsed) {
    target.luckyUsed = true;
    addLog(`🍀 [奇跡の幸運艦] ${target.name} が敵の攻撃を紙一重で完全回避！`, 'text-emerald-300 font-bold');
    attacker.acted = true;
    advanceTurn();
    return;
  }

  if (weapon === 'GUN') {
    let needed = dist <= 2 ? 3 : dist <= 4 ? 4 : 5;
    let mod = aiHitMod;

    if (attacker.movedThisTurn && attacker.shipId !== 'uk_bb3') mod -= 1;
    if (w.includes('荒波') && ['DD','CL','CA'].includes(attacker.type) && attacker.nation !== 'SU') mod -= 1;

    if (attacker.nation === 'SU' && dist <= 3) mod += 1;
    if (attacker.nation === 'ES' && attacker.hp <= attacker.maxHp / 2) mod += 1;
    const angle = getRelativeAngleType(attacker, target);
    if (attacker.nation === 'FR' && angle === 'BOW') mod += 1;

    if (attacker.shipId === 'jp_bb3' && dist <= 4) mod += 1;
    if (attacker.shipId === 'jp_bb4' && w.includes('夜間')) mod += 1;
    if (attacker.shipId === 'us_ca2' && attacker.hp <= 2) mod += 1;
    if (attacker.shipId === 'us_cl2' && target.type === 'DD') mod += 1;
    if (attacker.shipId === 'us_dd1' && target.cost > attacker.cost) mod += 1;
    if (attacker.shipId === 'de_bb_h39' && dist <= 4) mod += 1;
    if (attacker.shipId === 'de_bb3' && ['CA','CL','DD','SS'].includes(target.type)) mod += 1;
    if (attacker.shipId === 'uk_bb_vanguard' && dist >= 5) mod += 1;
    if (attacker.shipId === 'uk_bb1' && target.type === 'BB') mod += 1;
    if (attacker.shipId === 'uk_bb2' && dist >= 5) mod += 1;
    if (attacker.shipId === 'uk_ca2' && ['BB','CA'].includes(target.type)) mod += 1;
    if (attacker.shipId === 'it_bb_impero' && (w.includes('晴天') || w.includes('追い風'))) mod += 1;
    if (attacker.shipId === 'it_bb1' && w.includes('晴天')) mod += 1;
    if (attacker.shipId === 'fr_bb_alsace' && angle === 'BOW') mod += 1;
    if (attacker.shipId === 'fr_bb3' && ['CA','CL','DD','SS'].includes(target.type)) mod += 1;
    if (attacker.shipId === 'su_bb2' && dist >= 5) mod += 1;
    if (attacker.shipId === 'su_ca3' && ['DD','CL'].includes(target.type)) mod += 1;
    if (attacker.shipId === 'au_bb1' && dist >= 5) mod += 1;
    if (attacker.shipId === 'au_cl1' && target.cost > attacker.cost) mod += 1;
    if (attacker.shipId === 'au_cl2' && ['CA','CL','DD'].includes(target.type)) mod += 1;
    if (attacker.shipId === 'es_bb2' && dist <= 4) mod += 1;
    if (attacker.shipId === 'es_cl3' && w.includes('晴天')) mod += 1;
    if (attacker.shipId === 'nl_cl2' && ['DD','CL'].includes(target.type)) mod += 1;

    gameState.units.forEach(ally => {
      if (ally.uid !== attacker.uid && ally.team === attacker.team && ally.hp > 0 && !ally.isPlane) {
        const d = Math.max(Math.abs(ally.x - attacker.x), Math.abs(ally.y - attacker.y));
        if (d <= 1) {
          if (attacker.shipId === 'jp_bb1' && ally.shipId === 'jp_bb2') mod += 1;
          if (attacker.shipId === 'de_bb4' && ally.shipId === 'de_bb3') mod += 1;
          if (ally.shipId === 'de_ca1' && attacker.type === 'BB') mod += 1;
          if (attacker.shipId === 'de_ca1' && ally.type === 'BB') mod += 1;
          if (attacker.shipId === 'uk_bb6' && ally.type === 'BB' && ally.move >= 3) mod += 1;
        }
        if (d <= 2) {
          if (ally.shipId === 'jp_cl1' && attacker.type === 'DD') mod += 1;
          if (ally.shipId === 'it_ca2' && attacker.nation === 'IT') mod += 1;
          if (ally.shipId === 'su_ca1' && attacker.nation === 'SU') mod += 1;
          if (ally.shipId === 'su_dd1' && attacker.type === 'DD') mod += 1;
          if (ally.shipId === 'au_ca1' && attacker.nation === 'AU') mod += 1;
          if (ally.shipId === 'nl_cl1' && attacker.nation === 'NL') mod += 1;
        }
      }
    });

    if (target.shipId === 'de_cl1' && (target.x === 0 || target.x === 11 || target.y === 0 || target.y === 11)) mod -= 1;
    gameState.units.forEach(tAlly => {
      if (tAlly.uid !== target.uid && tAlly.team === target.team && tAlly.hp > 0 && !tAlly.isPlane) {
        const d = Math.max(Math.abs(tAlly.x - target.x), Math.abs(tAlly.y - target.y));
        if (d <= 1 && tAlly.nation === 'AU' && ['BB','CA'].includes(target.type)) mod -= 1;
        if (d <= 1 && tAlly.shipId === 'au_dd2' && ['BB','CA'].includes(target.type)) mod -= 1;
        if (d <= 2 && tAlly.shipId === 'nl_cl1' && target.nation === 'NL') mod -= 1;
      }
    });

    const rolls = [];
    let hits = 0;
    let hasSix = false;
    for (let i = 0; i < attacker.guns; i++) {
      const r = Math.floor(Math.random() * 6) + 1;
      rolls.push(r);
      if (r === 6) hasSix = true;
      if (r + mod >= needed) hits++;
    }

    let dmg = hits;
    if (hits > 0) {
      if (angle === 'BROADSIDE') dmg += 1;
      if (w.includes('夜間')) dmg += 1;
      if (w.includes('弾薬庫') && rolls.filter(r => r === 6).length >= 2) dmg += 3;
      if (attacker.nation === 'ES' && attacker.hp <= attacker.maxHp / 2) dmg += 1;
      if (attacker.shipId === 'jp_bb1' && hasSix) dmg += 1;
      if (attacker.shipId === 'us_bb_montana' && angle === 'BROADSIDE') dmg += 1;
      if (attacker.shipId === 'us_bb4') dmg += 1;
      if (attacker.shipId === 'it_bb2' && dist >= 5) dmg += 1;
      if (attacker.shipId === 'fr_bb_alsace' && angle === 'BOW') dmg += 1;
      if (attacker.shipId === 'fr_bb1' && angle === 'BOW') dmg += 1;
      if (attacker.shipId === 'su_bb3' && ['CA','CL','DD','SS'].includes(target.type)) dmg += 1;
      if (attacker.shipId === 'au_ca3' && ['BB','CA'].includes(target.type)) dmg += 1;
      if (attacker.shipId === 'es_bb1' && angle === 'BROADSIDE') dmg += 1;

      gameState.units.forEach(ally => {
        if (ally.uid !== attacker.uid && ally.team === attacker.team && ally.hp > 0 && Math.max(Math.abs(ally.x - attacker.x), Math.abs(ally.y - attacker.y)) <= 1) {
          if (attacker.shipId === 'jp_bb2' && ally.shipId === 'jp_bb1') dmg += 1;
          if (attacker.shipId === 'de_bb4' && ally.shipId === 'de_bb3') dmg += 1;
          if (attacker.shipId === 'nl_cl3' && (ally.shipId === 'nl_cl2' || ally.shipId === 'nl_cl1')) dmg += 1;
        }
      });

      dmg = applyDamageReduction(target, dmg, 'GUN');
      target.hp = Math.max(0, target.hp - dmg);
      addLog(`💥 [主砲斉射] ${attacker.name} → ${target.name} (${angle === 'BROADSIDE' ? '丁字/側面' : '縦陣'}・出目[${rolls.join(',')}]): ${dmg}ダメージ！(残HP:${target.hp})`, 'text-rose-300 font-bold');
      if (target.hp <= 0) handleUnitSunk(attacker, target);
    } else {
      addLog(`💨 [主砲斉射] ${attacker.name} → ${target.name} (出目[${rolls.join(',')}]): 全弾外れ！`, 'text-slate-400');
    }
  } else if (weapon === 'TORPEDO') {
    attacker.torp = Math.max(0, attacker.torp - 1);
    const wasSubmerged = attacker.type === 'SS' && attacker.submerged;
    if (wasSubmerged) {
      const staySubRoll = Math.floor(Math.random() * 6) + 1;
      if ((attacker.shipId === 'us_ss1' || attacker.shipId === 'de_ss2') && staySubRoll >= 4) {
        addLog(`🫧 ${attacker.name} は魚雷発射後も潜航状態を維持！`, 'text-cyan-300');
      } else {
        attacker.submerged = false;
        addLog(`⚠️ ${attacker.name} が魚雷発射に伴い海面に浮上！`, 'text-amber-300');
      }
    }

    const d1 = Math.floor(Math.random() * 6) + 1;
    const d2 = Math.floor(Math.random() * 6) + 1;
    let sum = d1 + d2 + aiHitMod;
    let needed = dist <= 2 ? 6 : dist === 3 ? 7 : 8;
    if (attacker.shipId === 'it_ss1' && dist <= 2) needed = 4;

    if (w.includes('スコール') || w.includes('濃霧')) sum += 1;
    if (w.includes('荒波') && attacker.nation !== 'SU') sum -= 2;
    if (attacker.nation === 'NL' && (w.includes('夜間') || w.includes('濃霧') || w.includes('スコール'))) sum += 1;
    if (wasSubmerged) sum += 2;
    if (attacker.shipId === 'jp_cl_kitakami' || attacker.shipId === 'de_ca2' || attacker.shipId === 'es_dd2' || attacker.shipId === 'nl_dd2') sum += 1;
    if ((attacker.shipId === 'de_ss1' || attacker.shipId === 'su_dd3' || attacker.shipId === 'au_dd6') && ['BB','CV'].includes(target.type)) sum += 1;
    if (attacker.shipId === 'it_dd2' && (w.includes('夜間') || w.includes('スコール'))) sum += 1;
    if (attacker.shipId === 'nl_dd1' && target.cost > attacker.cost) sum += 1;

    if (sum >= needed) {
      let dmg = attacker.torpDmg || 4;
      if (attacker.nation === 'JP' && attacker.type === 'DD') dmg += 1;
      if ((attacker.shipId === 'de_ss1' || attacker.shipId === 'it_ss2' || attacker.shipId === 'su_ss1' || attacker.shipId === 'nl_ss1') && ['BB','CV'].includes(target.type)) dmg += 1;
      if (attacker.shipId === 'nl_dd3' && (w.includes('夜間') || w.includes('濃霧'))) dmg += 1;
      if (w.includes('夜間')) dmg += 1;
      if (w.includes('弾薬庫') && d1 === 6 && d2 === 6) dmg += 3;

      dmg = applyDamageReduction(target, dmg, 'TORPEDO');
      target.hp = Math.max(0, target.hp - dmg);
      addLog(`🔱 [魚雷命中!] ${attacker.name} → ${target.name} (2D6=${d1}+${d2}→計${sum}/目標${needed}): ${dmg}ダメージ！(残HP:${target.hp})`, 'text-cyan-300 font-bold');
      if (target.hp <= 0) handleUnitSunk(attacker, target);
    } else {
      addLog(`🌊 [魚雷回避] ${attacker.name} → ${target.name} (2D6=${d1}+${d2}→計${sum}/目標${needed}): 回避された！`, 'text-slate-400');
    }
  } else if (weapon === 'DEPTH_CHARGE') {
    let roll = Math.floor(Math.random() * 6) + 1 + aiHitMod;
    if (attacker.shipId === 'de_cl2' || attacker.shipId === 'uk_dd2' || attacker.shipId === 'su_cl2' || attacker.shipId === 'au_dd1' || attacker.shipId === 'es_dd3' || attacker.shipId === 'nl_dd4') roll += 1;
    if (roll >= 4) {
      target.submerged = false;
      target.hp = Math.max(0, target.hp - 2);
      addLog(`💣 [爆雷直撃!] ${attacker.name} → ${target.name} (判定:${roll}): 2ダメージ＆強制浮上！(残HP:${target.hp})`, 'text-amber-300 font-bold');
      if (target.hp <= 0) handleUnitSunk(attacker, target);
    } else {
      addLog(`💦 [爆雷失敗] ${attacker.name} → ${target.name} (判定:${roll}): 潜水艦に逃げられた。`, 'text-slate-400');
    }
  } else if (weapon === 'DOGFIGHT') {
    let roll = Math.floor(Math.random() * 6) + 1 + aiHitMod;
    let needed = 4;
    if (['zero','f4u','bf109','spitfire','yak9','boomerang','cw21'].includes(attacker.planeId)) needed = 3;
    if (['shiden','me155'].includes(attacker.planeId)) needed = 2;
    if (roll >= needed) {
      addLog(`✈️ [空戦撃墜!] ${attacker.name} が敵機 ${target.name} を撃墜！(判定:${roll})`, 'text-sky-300 font-bold');
      removePlaneUnit(target);
    } else {
      addLog(`☁️ [空戦] ${attacker.name} と ${target.name} が交戦するも撃墜ならず。(判定:${roll})`, 'text-slate-400');
    }
  } else if (weapon === 'AIRSTRIKE') {
    let aaNeeded = (target.nation === 'US' || target.nation === 'AU' || target.shipId === 'uk_bb_vanguard' || target.shipId === 'uk_bb6' || target.shipId === 'fr_bb2' || target.shipId === 'su_cl1' || target.shipId === 'es_ca2' || target.shipId === 'es_cl4' || target.shipId === 'nl_cl5' || target.shipId === 'nl_dd6') ? 4 : 5;
    if (target.shipId === 'us_dd2' || target.shipId === 'au_dd5') aaNeeded = 3;
    if (attacker.planeId === 'swordfish') aaNeeded = 6;

    let aaRoll = Math.floor(Math.random() * 6) + 1;
    gameState.units.forEach(ally => {
      if (ally.team === target.team && ally.hp > 0 && !ally.isPlane && Math.max(Math.abs(ally.x - target.x), Math.abs(ally.y - target.y)) <= 2) {
        if (ally.shipId === 'us_bb3') aaRoll += 1;
      }
    });

    if (target.shipId === 'us_cl1' && !target.aaShieldUsed) {
      target.aaShieldUsed = true;
      addLog(`🛡️ [防空巡洋艦] ${target.name} の弾幕で ${attacker.name} の攻撃を無効化！`, 'text-sky-300 font-bold');
      returnPlaneToCarrier(attacker);
      attacker.acted = true;
      advanceTurn();
      return;
    }

    const immuneFirstAA = attacker.planeId === 'sbd' || attacker.planeId === 'il2' || attacker.planeId === 'seiran';
    if (!immuneFirstAA && aaRoll >= aaNeeded) {
      addLog(`🔥 [対空砲火!] ${target.name} の対空砲火が ${attacker.name} を撃墜！(出目:${aaRoll})`, 'text-amber-300 font-bold');
      removePlaneUnit(attacker);
      advanceTurn();
      return;
    }

    let atkRoll = Math.floor(Math.random() * 6) + 1 + aiHitMod;
    let atkNeeded = ['suisei','ryusei','ju87','fi167','seiran'].includes(attacker.planeId) ? 3 : 4;
    if (attacker.parentCvUid) {
      const cv = gameState.units.find(x => x.uid === attacker.parentCvUid);
      if (cv && cv.shipId === 'fr_cv2') atkRoll += 1;
      if (cv && cv.shipId === 'us_cv3' && gameState.round === 1) atkRoll += 1;
      if (cv && cv.shipId === 'jp_cv1') {
        const kagaNear = gameState.units.some(x => x.shipId === 'jp_cv2' && x.team === cv.team && x.hp > 0 && Math.max(Math.abs(x.x - cv.x), Math.abs(x.y - cv.y)) <= 1);
        if (kagaNear) atkRoll += 1;
      }
    }

    if (atkRoll >= atkNeeded) {
      let dmg = attacker.dmg || 3;
      if ((attacker.planeId === 'tenzan') && ['BB','CV'].includes(target.type)) dmg = 5;
      if (attacker.parentCvUid) {
        const cv = gameState.units.find(x => x.uid === attacker.parentCvUid);
        if (cv && cv.shipId === 'jp_cv2') dmg += 1;
        if (cv && cv.shipId === 'us_cv3' && gameState.round === 1) dmg += 1;
        if (cv && cv.shipId === 'uk_cv1') target.rudderDamaged = true;
      }
      if (attacker.planeId === 'swordfish') target.rudderDamaged = true;

      dmg = applyDamageReduction(target, dmg, 'AIR');
      target.hp = Math.max(0, target.hp - dmg);
      addLog(`💣 [航空攻撃命中!] ${attacker.name} → ${target.name} (判定:${atkRoll}): ${dmg}ダメージ！(残HP:${target.hp})`, 'text-rose-300 font-bold');
      if (target.hp <= 0) handleUnitSunk(attacker, target);
    } else {
      addLog(`💨 [航空攻撃回避] ${attacker.name} の爆撃・雷撃は ${target.name} に回避された。(判定:${atkRoll})`, 'text-slate-400');
    }
    returnPlaneToCarrier(attacker);
  }

  attacker.acted = true;
  advanceTurn();
}

function applyDamageReduction(target, rawDmg, sourceType) {
  let dmg = rawDmg;
  if (dmg <= 0) return 0;

  if (target.shipId === 'de_bb1' && target.hp <= 5 && !target.bismarckUsed) {
    target.bismarckUsed = true;
    addLog(`🛡️ [不沈の伝説] ${target.name} が致命的ダメージを完全無効化！`, 'text-amber-300 font-bold');
    return 0;
  }

  if (sourceType === 'GUN') {
    if (target.nation === 'DE' && ['BB','CA'].includes(target.type)) dmg = Math.max(1, dmg - 1);
    if (['jp_bb2','jp_cv_shinano','jp_cv4','it_ca1','su_bb1'].includes(target.shipId)) dmg = Math.max(1, dmg - 1);
    if (target.shipId === 'es_bb3' && target.hp <= 5) dmg = Math.max(1, dmg - 1);
  }
  if (sourceType === 'AIR') {
    if (['jp_cv_shinano','jp_cv5','jp_cv4','uk_cv2'].includes(target.shipId)) dmg = Math.max(1, dmg - 1);
  }
  if (target.shipId === 'it_bb4') {
    const inHome = (target.team === 'A' && target.y <= 5) || (target.team === 'B' && target.y >= 6);
    if (inHome) dmg = Math.max(1, dmg - 1);
  }
  return dmg;
}

function returnPlaneToCarrier(pl) {
  const cv = gameState.units.find(u => u.uid === pl.parentCvUid && u.hp > 0);
  if (cv) {
    cv.planesRemaining = Math.min(cv.maxPlanes, cv.planesRemaining + 1);
  }
  gameState.units = gameState.units.filter(u => u.uid !== pl.uid);
}

function removePlaneUnit(pl) {
  if (pl.parentCvUid) {
    const cv = gameState.units.find(u => u.uid === pl.parentCvUid && u.hp > 0);
    if (cv && cv.shipId === 'us_cv1' && cv.entRevives > 0) {
      cv.entRevives--;
      cv.planesRemaining = Math.min(cv.maxPlanes, cv.planesRemaining + 1);
      addLog(`🔥 [不死鳥の空母] エンタープライズが失われた艦載機を即時補充！(残補充:${cv.entRevives})`, 'text-sky-300');
    }
  }
  gameState.units = gameState.units.filter(u => u.uid !== pl.uid);
}

function handleUnitSunk(attacker, target) {
  target.hp = 0;
  target.acted = true;
  addLog(`☠️ 【轟沈】 ${target.name} が撃沈されました！！`, 'text-rose-500 font-black');
  if (target.type === 'CV' || target.shipId === 'jp_ss_i400') {
    gameState.units = gameState.units.filter(u => !(u.isPlane && u.parentCvUid === target.uid));
  }
  // Immediately purge sunk unit so no ghosts remain
  gameState.units = gameState.units.filter(u => u.uid !== target.uid && u.hp > 0);
  if (gameState.selectedUid === target.uid) {
    gameState.selectedUid = null;
  }
  if (!isAnyFortressMode() && gameState.targetVp > 0) {
    const gain = target.cost;
    gameState.players.forEach(p => {
      if (p.team === attacker.team) p.vp += gain;
    });
    addLog(`🏅 ${attacker.team}陣営が撃沈ボーナス +${gain}pt を獲得！`, 'text-amber-300 font-bold');
  }
}

// ==========================================
// 5. CARRIER LAUNCH, SUBMERGE & ROTATION ACTIONS
// ==========================================
function openLaunchModal(cv) {
  if (!cv || cv.hp <= 0) return;
  if (cv.type === 'SS' && cv.submerged) {
    showBanner('🫧 潜航中は特殊攻撃機『晴嵐』を発艦できません！先に浮上してください。');
    return;
  }
  if (gameState.weather.name.includes('スコール')) {
    showBanner('🌧️ スコール中は艦載機を発艦できません！');
    return;
  }
  const maxLaunch = cv.shipId === 'jp_cv1' ? 2 : 1;
  if ((cv.launchedThisTurn || 0) >= maxLaunch) {
    showBanner('今ターンの発艦上限に達しています！');
    return;
  }
  if (cv.planesRemaining <= 0) {
    showBanner('搭載機が残っていません！');
    return;
  }

  let planes = PLANES_BY_NATION[cv.nation] || PLANES_BY_NATION.JP;
  if (cv.shipId === 'jp_ss_i400') {
    planes = planes.filter(p => p.id === 'seiran');
  } else if (cv.nation === 'JP') {
    planes = planes.filter(p => p.id !== 'seiran');
  }
  const box = document.getElementById('modal-box');
  let listHtml = '';
  planes.forEach((pl) => {
    const realIdx = (PLANES_BY_NATION[cv.nation] || PLANES_BY_NATION.JP).findIndex(x => x.id === pl.id);
    listHtml += `
      <button onclick="launchPlane('${cv.uid}', ${realIdx})" class="w-full text-left p-3 bg-slate-800 hover:bg-sky-900/60 border border-slate-600 hover:border-sky-400 rounded-xl transition flex items-center justify-between gap-2">
        <div>
          <div class="font-black text-sm text-white">${pl.name} <span class="text-xs text-amber-300">[${pl.role}]</span></div>
          <div class="text-xs text-slate-300 mt-0.5">${pl.desc}</div>
        </div>
        <span class="px-3 py-1.5 bg-sky-600 text-white text-xs font-bold rounded-lg shrink-0">発艦！</span>
      </button>`;
  });

  box.innerHTML = `
    <div class="flex items-center justify-between mb-3">
      <h3 class="text-lg font-black text-white">🛫 ${cv.name} — 艦載機発艦選択 (残:${cv.planesRemaining}機)</h3>
      <button onclick="closeModal()" class="text-slate-400 hover:text-white font-bold">✕</button>
    </div>
    <div class="space-y-2">${listHtml}</div>
  `;
  document.getElementById('modal-overlay').classList.remove('hidden');
}

function launchPlane(cvUid, planeIdx) {
  closeModal();
  const cv = gameState.units.find(u => u.uid === cvUid && u.hp > 0);
  if (!cv || cv.planesRemaining <= 0) return;
  const templates = PLANES_BY_NATION[cv.nation] || PLANES_BY_NATION.JP;
  const tmpl = templates[planeIdx];
  if (!tmpl) return;

  let spawnX = cv.x, spawnY = cv.y;
  for (let d = 0; d < 8; d++) {
    const nx = cv.x + DIRS[d].dx;
    const ny = cv.y + DIRS[d].dy;
    if (nx >= 0 && nx < BOARD_SIZE && ny >= 0 && ny < BOARD_SIZE) {
      if (!gameState.units.some(u => u.hp > 0 && u.isPlane && u.team === cv.team && u.x === nx && u.y === ny)) {
        spawnX = nx; spawnY = ny;
        break;
      }
    }
  }

  cv.planesRemaining--;
  cv.launchedThisTurn = (cv.launchedThisTurn || 0) + 1;

  const newPlane = {
    uid: `pl_${Date.now()}_${Math.random().toString(36).slice(2,6)}`,
    ownerId: cv.ownerId,
    team: cv.team,
    nation: cv.nation,
    isPlane: true,
    parentCvUid: cv.uid,
    planeId: tmpl.id,
    role: tmpl.role,
    name: tmpl.name,
    type: 'AIR',
    cost: 0,
    hp: 1,
    maxHp: 1,
    move: tmpl.move,
    range: 1,
    guns: 0,
    torp: 0,
    dmg: tmpl.dmg,
    skillName: tmpl.role,
    skillDesc: tmpl.desc,
    x: spawnX,
    y: spawnY,
    dir: cv.dir,
    submerged: false,
    acted: false,
    movedThisTurn: false,
    stepsMoved: 0
  };

  gameState.units.push(newPlane);
  gameState.selectedUid = newPlane.uid;
  addLog(`🛫 ${cv.name} から ${tmpl.name} が発艦しました！`, 'text-sky-300 font-bold');
  renderInspector();
  renderActionControls();
  drawCanvas();
}

function toggleSubmergeSelectedUnit() {
  const u = gameState.units.find(x => x.uid === gameState.selectedUid && x.hp > 0);
  if (!u || u.type !== 'SS' || u.acted) return;
  u.submerged = !u.submerged;
  u.acted = true;
  addLog(`${u.submerged ? '🫧' : '⚠️'} ${u.name} が${u.submerged ? '潜航' : '浮上'}しました。`, 'text-cyan-300 font-bold');
  advanceTurn();
}

function extraTurnSelectedUnit(delta) {
  const u = gameState.units.find(x => x.uid === gameState.selectedUid && x.hp > 0);
  if (!u || u.isPlane || u.acted) return;
  const p = getCurrentPlayer();
  if (u.nation === 'UK' && !p.ukTurnUsedThisTurn) {
    p.ukTurnUsedThisTurn = true;
    u.dir = (u.dir + delta + 8) % 8;
    addLog(`🇬🇧 [英国艦隊機動] ${u.name} が45度追加旋回しました。`, 'text-emerald-300');
  } else if (u.shipId === 'jp_ca1' || u.shipId === 'fr_ca2') {
    u.dir = (u.dir + delta + 8) % 8;
    u.acted = true;
    addLog(`🧭 ${u.name} が追加45度旋回を行いました。`, 'text-sky-300');
    advanceTurn();
    return;
  }
  renderInspector();
  renderActionControls();
  drawCanvas();
}

function waitSelectedUnit() {
  const u = gameState.units.find(x => x.uid === gameState.selectedUid && x.hp > 0);
  if (!u || u.acted) return;
  u.acted = true;
  addLog(`⏸️ ${u.name} は現在位置で待機・警戒態勢をとりました。`, 'text-slate-400');
  advanceTurn();
}

// ==========================================
// 6. AI OPPONENT LOGIC (DIFFICULTY AWARE)
// ==========================================
function selectAITarget(targets, diffCfg) {
  if (!targets || targets.length === 0) return null;
  let pool = [...targets];

  // Difficulty-based torpedo restraint
  if (diffCfg.torpChance < 1.0) {
    const filtered = pool.filter(t => t.weapon !== 'TORPEDO' || Math.random() < diffCfg.torpChance);
    if (filtered.length > 0) {
      pool = filtered;
    } else if (pool.every(t => t.weapon === 'TORPEDO')) {
      return null; // Hold torpedo fire this turn on easier settings
    }
  }

  // Focus fire on high-value / low-HP targets vs random target selection
  if (Math.random() < diffCfg.focusChance) {
    pool.sort((a, b) => {
      const scoreA = (a.unit.isFortress ? 100 : a.unit.cost * 10) + (a.unit.hp <= 3 ? 15 : 0);
      const scoreB = (b.unit.isFortress ? 100 : b.unit.cost * 10) + (b.unit.hp <= 3 ? 15 : 0);
      return scoreB - scoreA;
    });
    return pool[0];
  } else {
    return pool[Math.floor(Math.random() * pool.length)];
  }
}

function runAITurnStep() {
  if (!gameState || gameState.gameOver) return;
  gameState.units = gameState.units.filter(u => u.hp > 0);
  const p = getCurrentPlayer();
  if (!p || !p.isAI) return;

  const diffCfg = getAiDiffConfig();
  const readyUnits = gameState.units.filter(u => u.ownerId === p.id && !u.acted && !u.isFortress && u.hp > 0);
  if (readyUnits.length === 0) {
    advanceTurn();
    return;
  }

  const u = readyUnits[0];
  gameState.selectedUid = u.uid;
  updateHUD();
  renderInspector();
  drawCanvas();

  // AI Submarine (SS) tactical surface/submerge management
  if (u.type === 'SS' && u.submerged) {
    const visibleEnemies = gameState.units.filter(en => !en.isPlane && en.team !== u.team && en.hp > 0 && !en.submerged);
    const minDistToEnemy = visibleEnemies.length > 0
      ? Math.min(...visibleEnemies.map(en => Math.max(Math.abs(en.x - u.x), Math.abs(en.y - u.y))))
      : 99;
    if (u.torp <= 0 || (u.shipId === 'jp_ss_i400' && u.planesRemaining > 0 && minDistToEnemy <= 7) || minDistToEnemy > getEffectiveTorpRange(u) + 1) {
      u.submerged = false;
      addLog(`⚠️ [AI潜航解除] ${u.name} が海面に浮上しました！`, 'text-amber-300');
    }
  }

  // Carrier / I-400 aircraft launch decision based on difficulty launchChance
  if ((u.type === 'CV' || (u.shipId === 'jp_ss_i400' && !u.submerged)) && u.planesRemaining > 0 && !gameState.weather.name.includes('スコール')) {
    if (Math.random() < diffCfg.launchChance) {
      const templates = PLANES_BY_NATION[u.nation] || PLANES_BY_NATION.JP;
      let pickIdx = 0;
      if (u.shipId === 'jp_ss_i400') {
        pickIdx = templates.findIndex(t => t.id === 'seiran');
      } else {
        const attackPlanes = templates.map((t, i) => ({ t, i })).filter(x => x.t.role !== 'RECON' && x.t.id !== 'seiran');
        const pick = attackPlanes[Math.floor(Math.random() * attackPlanes.length)] || { i: 0 };
        pickIdx = pick.i;
      }
      launchPlane(u.uid, Math.max(0, pickIdx));
      u.acted = true;
      setTimeout(() => runAITurnStep(), Math.max(40, Math.floor(gameState.aiSpeed * 0.8)));
      return;
    }
  }

  // Pre-move attack check
  let targets = getAttackableTargets(u);
  const preMoveTarget = selectAITarget(targets, diffCfg);
  if (preMoveTarget) {
    executeAttack(u, preMoveTarget);
    return;
  }

  // Movement decision (easier AI occasionally holds position or picks suboptimal maneuvers)
  const shouldMove = Math.random() >= diffCfg.waitChance;
  const moves = shouldMove ? getValidMoves(u) : [];
  if (moves.length > 0) {
    const enemies = gameState.units.filter(en => !en.isPlane && en.team !== u.team && en.hp > 0 && !en.submerged);
    if (enemies.length > 0) {
      enemies.sort((a, b) => {
        if (isSingleFortressMode() && a.isFortress) return -1;
        if (isSingleFortressMode() && b.isFortress) return 1;
        if (isDualFortressMode() && a.isFortress) return -1;
        if (isDualFortressMode() && b.isFortress) return 1;
        return Math.hypot(a.x - u.x, a.y - u.y) - Math.hypot(b.x - u.x, b.y - u.y);
      });
      const goal = (Math.random() < diffCfg.focusChance)
        ? enemies[0]
        : enemies[Math.floor(Math.random() * enemies.length)];

      moves.sort((m1, m2) => Math.hypot(m1.x - goal.x, m1.y - goal.y) - Math.hypot(m2.x - goal.x, m2.y - goal.y));
      let bestMove = moves[0];
      if (Math.random() >= diffCfg.smartMoveChance && moves.length > 1) {
        const subPool = moves.slice(0, Math.min(moves.length, 4));
        bestMove = subPool[Math.floor(Math.random() * subPool.length)];
      }
      u.x = bestMove.x;
      u.y = bestMove.y;
      u.dir = bestMove.dir;
      u.movedThisTurn = true;
      u.stepsMoved = getEffectiveMove(u);
      addLog(`🤖 ${u.name} が (${u.x + 1}, ${u.y + 1}) へ機動。`, 'text-slate-300');
    }
  } else if (!shouldMove) {
    addLog(`🤖 ${u.name} は現在位置で様子をうかがっている。`, 'text-slate-400');
  }

  // Post-move attack check
  targets = getAttackableTargets(u);
  const postMoveTarget = selectAITarget(targets, diffCfg);
  if (postMoveTarget) {
    executeAttack(u, postMoveTarget);
    return;
  }

  u.acted = true;
  advanceTurn();
}

