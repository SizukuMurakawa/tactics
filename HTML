      showBanner(`${setupState.players[i].name} の艦隊が0隻です！1隻以上編入してください。`);
      return;
    }
  }

  const activePlayers = [];
  const units = [];
  let uidCounter = 1;
  const mapGrid = generateMap(setupState.stage);

  if (isAnyFortressMode()) {
    mapGrid[1][5] = 0;
    mapGrid[1][6] = 1;
    units.push({
      uid: 'fortress_north',
