      move: 0,
      range: 3,
      guns: 2,
      torp: 0,
      maxTorp: 0,
      torpDmg: 0,
      skillName: '沿岸要塞砲＆港湾ドック',
      skillDesc: 'R終了時に周囲3マスの敵へ自動砲撃(2ダメ)＆周囲2マスの味方艦をHP+1修理。',
      x: 5,
      y: 1,
      dir: 4,
      submerged: false,
      acted: true
    });

    if (isDualFortressMode()) {
      mapGrid[10][5] = 0;
      mapGrid[10][6] = 1;
      const southOwner = setupState.players.slice(0, count).find(p => p.team === 'B') || setupState.players[1];
      units.push({
