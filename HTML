function isSingleFortressMode() { return setupState.battleFormat === 'fortress_single'; }
function isDualFortressMode() { return setupState.battleFormat === 'fortress_dual'; }
function isAnyFortressMode() { return isSingleFortressMode() || isDualFortressMode(); }

function getEffectiveCostLimit(pIdx) {
  const p = setupState.players[pIdx];
  let limit = setupState.costLimit;
  if (p.nation === 'US') limit += 1;
  if (isSingleFortressMode() && p.team === 'B') limit += 3;
  return limit;
}

function getFleetCost(fleetIds) {
  return fleetIds.reduce((sum, id) => {
    const s = SHIPS_DB.find(x => x.id === id);
    return sum + (s ? s.cost : 0);
  }, 0);
}

function trimFleetToLimit(pIdx) {
  const limit = getEffectiveCostLimit(pIdx);
  const p = setupState.players[pIdx];
  while (getFleetCost(p.fleet) > limit && p.fleet.length > 0) {
    p.fleet.pop();
  }
}

function getActivePlayerCount() {
  const m = setupState.mode;
  if (m === '1v1_ai' || m === '1v1_pvp') return 2;
  if (m === '1v2_hard' || m === '1v1v1_ai' || m === '1v1v1_pvp') return 3;
  return 4;
}

function onModeChange() {
  setupState.battleFormat = document.getElementById('battle-format-select').value;
  setupState.mode = document.getElementById('game-mode-select').value;
  const stageEl = document.getElementById('stage-select');

  if (isAnyFortressMode()) {
    if (setupState.mode === '1v1v1_ai') { setupState.mode = '1v1_ai'; document.getElementById('game-mode-select').value = '1v1_ai'; }
    if (setupState.mode === '1v1v1_pvp') { setupState.mode = '1v1_pvp'; document.getElementById('game-mode-select').value = '1v1_pvp'; }
    if (setupState.mode === 'ffa_ai') { setupState.mode = '2v2_ai'; document.getElementById('game-mode-select').value = '2v2_ai'; }
    if (setupState.mode === 'ffa_pvp') { setupState.mode = '2v2_pvp'; document.getElementById('game-mode-select').value = '2v2_pvp'; }
    stageEl.value = 'fortress';
    setupState.stage = 'fortress';
    if (isSingleFortressMode() && setupState.maxRounds === 0) {
      setupState.maxRounds = 8;
      document.getElementById('max-rounds-select').value = '8';
    }
  }

  const m = setupState.mode;
  const descEl = document.getElementById('mode-description');
  const p = setupState.players;

  if (m === '1v1_ai') {
    p[0] = { ...p[0], name: 'P1 (北軍)', isAI: false, team: 'A' };
    p[1] = { ...p[1], name: 'P2 (南軍・AI)', isAI: true, team: 'B' };
  } else if (m === '1v1_pvp') {
