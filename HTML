const canvas = document.getElementById('game-canvas');
const ctx = canvas.getContext('2d');
let cellSize = 44;
let boardOffsetX = 0;
let boardOffsetY = 0;

function resizeCanvas() {
  const wrapper = document.getElementById('canvas-wrapper');
  if (!wrapper) return;
  const w = wrapper.clientWidth;
  const h = wrapper.clientHeight;
  canvas.width = w;
  canvas.height = h;
  const minDim = Math.min(w - 16, h - 16);
  cellSize = Math.max(24, Math.floor(minDim / BOARD_SIZE));
  boardOffsetX = Math.floor((w - cellSize * BOARD_SIZE) / 2);
  boardOffsetY = Math.floor((h - cellSize * BOARD_SIZE) / 2);
  drawCanvas();
}

window.addEventListener('resize', () => {
  if (gameState) resizeCanvas();
});

// Top-down realistic naval silhouette renderer
function drawUnitSilhouette(ctx, u, cx, cy, size, fillColor, strokeColor) {
  ctx.save();
  ctx.translate(cx, cy);

  if (u.isFortress) {
    const r = size * 0.4;
    ctx.beginPath();
    for (let i = 0; i < 8; i++) {
      const a = (Math.PI / 4) * i + Math.PI / 8;
      const vx = Math.cos(a) * r;
      const vy = Math.sin(a) * r;
      if (i === 0) ctx.moveTo(vx, vy);
      else ctx.lineTo(vx, vy);
    }
    ctx.closePath();
    ctx.fillStyle = fillColor;
    ctx.fill();
    ctx.lineWidth = 2.2;
    ctx.strokeStyle = strokeColor;
    ctx.stroke();

    ctx.fillStyle = '#1e293b';
    ctx.beginPath();
    ctx.arc(0, 0, r * 0.55, 0, Math.PI * 2);
    ctx.fill();
    ctx.strokeStyle = '#cbd5e1';
    ctx.lineWidth = 1.2;
    ctx.stroke();

    const dirRad = (u.dir * Math.PI) / 4;
    ctx.rotate(dirRad);
    ctx.fillStyle = '#e2e8f0';
    ctx.fillRect(-3.5, -r * 0.85, 2.2, r * 0.65);
    ctx.fillRect(1.3, -r * 0.85, 2.2, r * 0.65);
    ctx.restore();
    return;
  }

  const angleRad = (u.dir * Math.PI) / 4;
  ctx.rotate(angleRad);

  if (u.isPlane) {
    const s = size * 0.36;
    ctx.fillStyle = 'rgba(2, 6, 23, 0.45)';
    ctx.beginPath();
    ctx.ellipse(3, 5, s * 0.95, s * 0.24, 0, 0, Math.PI * 2);
    ctx.fill();

    ctx.fillStyle = fillColor;
    ctx.strokeStyle = strokeColor;
    ctx.lineWidth = 1.6;

    ctx.beginPath();
    ctx.moveTo(0, -s * 0.35);
    ctx.lineTo(s * 1.05, -s * 0.05);
    ctx.lineTo(s * 0.95, s * 0.2);
    ctx.lineTo(0, s * 0.12);
    ctx.lineTo(-s * 0.95, s * 0.2);
    ctx.lineTo(-s * 1.05, -s * 0.05);
    ctx.closePath();
    ctx.fill();
    ctx.stroke();

    ctx.beginPath();
    ctx.moveTo(0, -s * 0.95);
    ctx.lineTo(s * 0.16, -s * 0.3);
    ctx.lineTo(s * 0.12, s * 0.65);
    ctx.lineTo(s * 0.42, s * 0.85);
    ctx.lineTo(0, s * 0.78);
    ctx.lineTo(-s * 0.42, s * 0.85);
    ctx.lineTo(-s * 0.12, s * 0.65);
    ctx.lineTo(-s * 0.16, -s * 0.3);
    ctx.closePath();
    ctx.fill();
    ctx.stroke();

    ctx.fillStyle = '#e0f2fe';
    ctx.beginPath();
    ctx.ellipse(0, -s * 0.15, s * 0.1, s * 0.22, 0, 0, Math.PI * 2);
    ctx.fill();

    ctx.restore();
    return;
  }

  if (!u.submerged) {
    ctx.strokeStyle = 'rgba(186, 230, 253, 0.32)';
    ctx.lineWidth = 1.2;
    ctx.beginPath();
    ctx.moveTo(-size * 0.12, size * 0.36);
    ctx.lineTo(-size * 0.24, size * 0.48);
    ctx.moveTo(size * 0.12, size * 0.36);
    ctx.lineTo(size * 0.24, size * 0.48);
    ctx.stroke();
  }

  if (u.type === 'BB') {
    const L = size * 0.45;
    const W = size * 0.17;
    ctx.beginPath();
    ctx.moveTo(0, -L);
    ctx.quadraticCurveTo(W * 0.95, -L * 0.45, W, 0);
    ctx.quadraticCurveTo(W * 0.95, L * 0.75, W * 0.55, L);
    ctx.lineTo(-W * 0.55, L);
    ctx.quadraticCurveTo(-W * 0.95, L * 0.75, -W, 0);
    ctx.quadraticCurveTo(-W * 0.95, -L * 0.45, 0, -L);
    ctx.closePath();
    ctx.fillStyle = fillColor;
    ctx.fill();
    ctx.lineWidth = 1.8;
    ctx.strokeStyle = strokeColor;
    ctx.stroke();

    ctx.strokeStyle = 'rgba(255,255,255,0.28)';
    ctx.lineWidth = 1;
    ctx.strokeRect(-W * 0.45, -L * 0.5, W * 0.9, L * 1.15);

    ctx.fillStyle = '#0f172a';
    ctx.fillRect(-W * 0.55, -L * 0.18, W * 1.1, L * 0.38);

    ctx.fillStyle = '#e2e8f0';
    ctx.fillRect(-W * 0.35, -L * 0.52, W * 0.7, L * 0.14);
    ctx.fillRect(-2.2, -L * 0.72, 1.2, L * 0.22);
    ctx.fillRect(0, -L * 0.74, 1.2, L * 0.24);
    ctx.fillRect(2.2, -L * 0.72, 1.2, L * 0.22);
    ctx.fillRect(-W * 0.35, -L * 0.34, W * 0.7, L * 0.13);
    ctx.fillRect(-W * 0.35, L * 0.36, W * 0.7, L * 0.14);
    ctx.fillRect(-1.8, L * 0.5, 1.2, L * 0.22);
    ctx.fillRect(0.6, L * 0.5, 1.2, L * 0.22);

  } else if (u.type === 'CV') {
    const L = size * 0.45;
    const W = size * 0.2;
    ctx.beginPath();
    ctx.moveTo(-W * 0.75, -L);
    ctx.lineTo(W * 0.75, -L);
    ctx.lineTo(W, -L * 0.55);
    ctx.lineTo(W, L * 0.85);
    ctx.lineTo(W * 0.7, L);
    ctx.lineTo(-W * 0.7, L);
    ctx.lineTo(-W, L * 0.85);
    ctx.lineTo(-W, -L * 0.55);
    ctx.closePath();
    ctx.fillStyle = fillColor;
    ctx.fill();
    ctx.lineWidth = 1.8;
    ctx.strokeStyle = strokeColor;
    ctx.stroke();

    ctx.fillStyle = '#1e293b';
    ctx.fillRect(-W * 0.72, -L * 0.92, W * 1.44, L * 1.84);
    ctx.strokeStyle = 'rgba(255,255,255,0.75)';
    ctx.lineWidth = 1.2;
    ctx.setLineDash([3, 3]);
    ctx.beginPath();
    ctx.moveTo(0, -L * 0.88);
    ctx.lineTo(0, L * 0.88);
    ctx.stroke();
    ctx.setLineDash([]);

    ctx.fillStyle = '#f8fafc';
    ctx.fillRect(W * 0.42, -L * 0.22, W * 0.38, L * 0.36);

  } else if (u.type === 'CA' || u.type === 'CL') {
    const L = size * 0.43;
    const W = u.type === 'CA' ? size * 0.13 : size * 0.11;
    ctx.beginPath();
    ctx.moveTo(0, -L);
    ctx.quadraticCurveTo(W, -L * 0.35, W, L * 0.25);
    ctx.lineTo(W * 0.65, L);
    ctx.lineTo(-W * 0.65, L);
    ctx.lineTo(-W, L * 0.25);
    ctx.quadraticCurveTo(-W, -L * 0.35, 0, -L);
    ctx.closePath();
    ctx.fillStyle = fillColor;
    ctx.fill();
    ctx.lineWidth = 1.7;
    ctx.strokeStyle = strokeColor;
    ctx.stroke();

    ctx.fillStyle = '#0f172a';
    ctx.fillRect(-W * 0.55, -L * 0.22, W * 1.1, L * 0.45);

    ctx.fillStyle = '#e2e8f0';
    ctx.fillRect(-W * 0.38, -L * 0.52, W * 0.76, L * 0.14);
    ctx.fillRect(-1.5, -L * 0.72, 1.1, L * 0.2);
    ctx.fillRect(0.6, -L * 0.72, 1.1, L * 0.2);
    ctx.fillRect(-W * 0.38, L * 0.4, W * 0.76, L * 0.14);
    ctx.fillRect(-1.5, L * 0.54, 1.1, L * 0.2);
    ctx.fillRect(0.6, L * 0.54, 1.1, L * 0.2);

  } else if (u.type === 'DD') {
    const L = size * 0.39;
    const W = size * 0.095;
    ctx.beginPath();
    ctx.moveTo(0, -L);
    ctx.quadraticCurveTo(W * 1.1, -L * 0.2, W * 0.85, L * 0.7);
    ctx.lineTo(W * 0.5, L);
    ctx.lineTo(-W * 0.5, L);
    ctx.lineTo(-W * 0.85, L * 0.7);
    ctx.quadraticCurveTo(-W * 1.1, -L * 0.2, 0, -L);
    ctx.closePath();
    ctx.fillStyle = fillColor;
    ctx.fill();
    ctx.lineWidth = 1.6;
    ctx.strokeStyle = strokeColor;
    ctx.stroke();

    ctx.fillStyle = '#0f172a';
    ctx.fillRect(-W * 0.55, -L * 0.3, W * 1.1, L * 0.22);
    ctx.fillStyle = '#38bdf8';
    ctx.fillRect(-W * 0.65, L * 0.05, W * 1.3, L * 0.16);
    ctx.fillStyle = '#e2e8f0';
    ctx.fillRect(-1, -L * 0.68, 2, L * 0.22);

  } else if (u.type === 'SS') {
    const L = size * 0.38;
    const W = size * 0.085;
    if (u.submerged) {
      ctx.strokeStyle = 'rgba(34, 211, 238, 0.55)';
      ctx.lineWidth = 1.2;
      ctx.beginPath();
      ctx.arc(0, 0, L * 0.9, 0, Math.PI * 2);
      ctx.stroke();
    }
    ctx.beginPath();
    ctx.ellipse(0, 0, W, L, 0, 0, Math.PI * 2);
    ctx.fillStyle = fillColor;
    ctx.fill();
    ctx.lineWidth = 1.6;
    ctx.strokeStyle = strokeColor;
    ctx.stroke();

    // I-400 submarine carrier hangar deck detail
    if (u.shipId === 'jp_ss_i400') {
      ctx.fillStyle = '#38bdf8';
      ctx.fillRect(-W * 0.45, -L * 0.55, W * 0.9, L * 0.45);
    }

    ctx.fillStyle = '#0f172a';
    ctx.beginPath();
    ctx.ellipse(0, -L * 0.08, W * 0.55, L * 0.24, 0, 0, Math.PI * 2);
    ctx.fill();
    ctx.strokeStyle = '#67e8f9';
    ctx.lineWidth = 1;
    ctx.stroke();
  }

  ctx.restore();
}

function drawCanvas() {
  if (!gameState) return;
  ctx.clearRect(0, 0, canvas.width, canvas.height);

  const selectedUnit = gameState.units.find(u => u.uid === gameState.selectedUid && u.hp > 0);
  const currentPlayer = getCurrentPlayer();
  const canControl = selectedUnit && !currentPlayer.isAI && selectedUnit.ownerId === currentPlayer.id && !selectedUnit.acted && !selectedUnit.isFortress;

  const validMoves = (canControl && !selectedUnit.movedThisTurn) ? getStepMoveOptions(selectedUnit) : [];
  const attackables = canControl ? getAttackableTargets(selectedUnit) : [];

  for (let r = 0; r < BOARD_SIZE; r++) {
    for (let c = 0; c < BOARD_SIZE; c++) {
      const px = boardOffsetX + c * cellSize;
      const py = boardOffsetY + r * cellSize;
      const cell = gameState.grid[r][c];

      ctx.fillStyle = cell === 1 ? '#14532d' : cell === 2 ? '#0e7490' : cell === 3 ? '#1e3a8a' : '#0f172a';
      ctx.fillRect(px, py, cellSize, cellSize);

      ctx.strokeStyle = '#1e293b';
      ctx.lineWidth = 1;
      ctx.strokeRect(px, py, cellSize, cellSize);

      if (cell === 1) {
        ctx.fillStyle = '#4ade80';
        ctx.font = `bold ${Math.floor(cellSize * 0.42)}px sans-serif`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText('🏝️', px + cellSize / 2, py + cellSize / 2);
      } else if (cell === 2) {
        ctx.fillStyle = 'rgba(103, 232, 249, 0.35)';
        ctx.font = `bold ${Math.floor(cellSize * 0.24)}px sans-serif`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText('浅瀬', px + cellSize / 2, py + cellSize / 2);
      } else if (cell === 3) {
        ctx.fillStyle = '#fbbf24';
        ctx.font = `bold ${Math.floor(cellSize * 0.36)}px sans-serif`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText('★', px + cellSize / 2, py + cellSize / 2);
      }
    }
  }

  validMoves.forEach(m => {
    const px = boardOffsetX + m.x * cellSize;
    const py = boardOffsetY + m.y * cellSize;
    ctx.fillStyle = m.isReverse ? 'rgba(250, 204, 21, 0.28)' : 'rgba(56, 189, 248, 0.32)';
    ctx.fillRect(px + 2, py + 2, cellSize - 4, cellSize - 4);
    ctx.strokeStyle = m.isReverse ? '#facc15' : '#38bdf8';
    ctx.lineWidth = 2;
    ctx.strokeRect(px + 2, py + 2, cellSize - 4, cellSize - 4);

    ctx.fillStyle = m.isReverse ? '#fef08a' : 'rgba(224, 242, 254, 0.85)';
    ctx.font = `bold ${Math.max(10, Math.floor(cellSize * 0.26))}px sans-serif`;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(m.isReverse ? '後退' : DIRS[m.dir].icon, px + cellSize / 2, py + cellSize / 2);
  });

  attackables.forEach(a => {
    const px = boardOffsetX + a.unit.x * cellSize;
    const py = boardOffsetY + a.unit.y * cellSize;
    ctx.fillStyle = 'rgba(244, 63, 94, 0.34)';
    ctx.fillRect(px + 2, py + 2, cellSize - 4, cellSize - 4);
    ctx.strokeStyle = '#f43f5e';
    ctx.lineWidth = 2;
    ctx.strokeRect(px + 2, py + 2, cellSize - 4, cellSize - 4);
  });

  const sortedUnits = [...gameState.units].sort((a, b) => (a.isPlane === b.isPlane ? 0 : a.isPlane ? 1 : -1));
  sortedUnits.forEach(u => {
    if (u.hp <= 0) return;
    if (u.submerged && !currentPlayer.isAI && u.team !== currentPlayer.team) return;

    const cx = boardOffsetX + u.x * cellSize + cellSize / 2;
    const cy = boardOffsetY + u.y * cellSize + cellSize / 2;
    const nat = NATIONS[u.nation] || NATIONS.JP;

    ctx.save();
    if (u.submerged) ctx.globalAlpha = 0.58;

    if (selectedUnit && selectedUnit.uid === u.uid) {
      ctx.beginPath();
      ctx.arc(cx, cy, cellSize * 0.45, 0, Math.PI * 2);
      ctx.strokeStyle = '#facc15';
      ctx.lineWidth = 2.5;
      ctx.stroke();
    }

    const fillColor = u.acted ? '#475569' : nat.color;
    const strokeColor = u.team === 'A' ? '#93c5fd' : u.team === 'B' ? '#fda4af' : '#fde047';
    drawUnitSilhouette(ctx, u, cx, u.isPlane ? cy - cellSize * 0.1 : cy, cellSize, fillColor, strokeColor);

    const shortName = u.name.replace(/\s*\(.*?\)/g, '').slice(0, 6);
    const fontSize = Math.max(9, Math.floor(cellSize * (shortName.length >= 5 ? 0.2 : 0.23)));
    ctx.font = `900 ${fontSize}px 'Noto Sans JP', sans-serif`;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.lineWidth = 3;
    ctx.strokeStyle = '#020617';
    const labelY = boardOffsetY + (u.y + 1) * cellSize - 13;
    ctx.strokeText(shortName, cx, labelY);
    ctx.fillStyle = '#ffffff';
    ctx.fillText(shortName, cx, labelY);

    const barW = cellSize * 0.74;
    const barH = 3.5;
    const bx = cx - barW / 2;
    const by = boardOffsetY + (u.y + 1) * cellSize - 6;
    ctx.fillStyle = '#020617';
    ctx.fillRect(bx, by, barW, barH);
    const hpRatio = Math.max(0, u.hp / u.maxHp);
    ctx.fillStyle = hpRatio > 0.5 ? '#22c55e' : hpRatio > 0.25 ? '#eab308' : '#ef4444';
    ctx.fillRect(bx, by, barW * hpRatio, barH);

    ctx.restore();
  });
}

function openWeaponChoiceModal(attacker, options) {
  const box = document.getElementById('modal-box');
  let btns = '';
  options.forEach((opt, idx) => {
    btns += `
      <button onclick="selectWeaponChoice(${idx})" class="w-full text-left p-3 bg-slate-800 hover:bg-rose-950/70 border border-slate-600 hover:border-rose-400 rounded-xl transition flex items-center justify-between">
        <span class="font-black text-sm text-white">${opt.label}</span>
        <span class="px-3 py-1 bg-rose-600 text-white text-xs font-bold rounded-lg">発射！</span>
      </button>`;
  });
  window._pendingWeaponOptions = { attacker, options };
  box.innerHTML = `
    <div class="flex items-center justify-between mb-3">
      <h3 class="text-base font-black text-white">🎯 ${attacker.name} → ${options[0].unit.name}：攻撃兵装を選択</h3>
      <button onclick="closeModal()" class="text-slate-400 hover:text-white font-bold">✕</button>
    </div>
    <div class="space-y-2">${btns}</div>
  `;
  document.getElementById('modal-overlay').classList.remove('hidden');
}

function selectWeaponChoice(idx) {
  const pending = window._pendingWeaponOptions;
  closeModal();
  if (pending && pending.options[idx]) {
    executeAttack(pending.attacker, pending.options[idx]);
  }
}

canvas.addEventListener('click', (e) => {
  if (!gameState || gameState.gameOver) return;
  const currentPlayer = getCurrentPlayer();
  if (currentPlayer.isAI) return;

  const rect = canvas.getBoundingClientRect();
  const mx = e.clientX - rect.left;
  const my = e.clientY - rect.top;
  const gx = Math.floor((mx - boardOffsetX) / cellSize);
  const gy = Math.floor((my - boardOffsetY) / cellSize);
  if (gx < 0 || gx >= BOARD_SIZE || gy < 0 || gy >= BOARD_SIZE) return;

  const selectedUnit = gameState.units.find(u => u.uid === gameState.selectedUid && u.hp > 0);

  if (selectedUnit && selectedUnit.ownerId === currentPlayer.id && !selectedUnit.acted && !selectedUnit.isFortress) {
    const matchingAttacks = getAttackableTargets(selectedUnit).filter(a => a.unit.x === gx && a.unit.y === gy);
    if (matchingAttacks.length > 0) {
      if (matchingAttacks.length === 1) {
        executeAttack(selectedUnit, matchingAttacks[0]);
      } else {
        openWeaponChoiceModal(selectedUnit, matchingAttacks);
      }
      return;
    }

    if (!selectedUnit.movedThisTurn) {
      const moveOpt = getStepMoveOptions(selectedUnit).find(m => m.x === gx && m.y === gy);
      if (moveOpt) {
        executeMove(selectedUnit, moveOpt);
        return;
      }
    }
  }

  const unitsHere = gameState.units.filter(u => u.x === gx && u.y === gy && u.hp > 0);
  const visibleHere = unitsHere.filter(u => !(u.submerged && u.team !== currentPlayer.team));
  if (visibleHere.length > 0) {
    const ownReady = visibleHere.find(u => u.ownerId === currentPlayer.id && !u.acted && !u.isFortress);
    const chosen = ownReady || visibleHere[0];
    gameState.selectedUid = chosen.uid;
    renderInspector();
    renderActionControls();
    drawCanvas();
  }
});

// ==========================================
// 8. HUD, INSPECTOR, LOG & MODALS
// ==========================================
function updateHUD() {
  if (!gameState) return;
  const roundLabel = gameState.maxRounds > 0 ? `R${gameState.round} / ${gameState.maxRounds}` : `R${gameState.round} / ∞`;
  document.getElementById('hud-round').textContent = roundLabel;
  document.getElementById('hud-weather').textContent = gameState.weather.name;

  const p = getCurrentPlayer();
  const turnEl = document.getElementById('hud-turn');
  turnEl.textContent = `${p.name} のターン`;
  turnEl.className = `px-2.5 py-1 rounded-lg text-xs font-black text-white ${p.team === 'A' ? 'bg-blue-600' : p.team === 'B' ? 'bg-rose-600' : 'bg-emerald-600'}`;

  const diffBtn = document.getElementById('hud-ai-diff-btn');
  if (diffBtn) {
    const diffCfg = getAiDiffConfig(gameState.aiDifficulty);
    diffBtn.textContent = diffCfg.hudLabel;
  }

  const speedBtn = document.getElementById('hud-ai-speed-btn');
  if (speedBtn) {
    const spd = gameState.aiSpeed;
    speedBtn.textContent = spd >= 800 ? '🐢 AI速度:ゆっくり' : spd >= 400 ? '▶️ AI速度:標準' : spd >= 150 ? '⚡ AI速度:高速' : '🚀 AI速度:超高速';
  }

  const scoresEl = document.getElementById('hud-scores');
  if (isAnyFortressMode()) {
    const nHq = gameState.units.find(u => u.uid === 'fortress_north');
    const sHq = gameState.units.find(u => u.uid === 'fortress_south');
    let hqHtml = `<span class="px-2 py-0.5 bg-blue-950 border border-blue-600 text-blue-200 rounded">🏰 北要塞 HP: ${nHq ? nHq.hp : 0}/25</span>`;
    if (sHq) {
      hqHtml += `<span class="px-2 py-0.5 bg-rose-950 border border-rose-600 text-rose-200 rounded">🏯 南要塞 HP: ${sHq.hp}/25</span>`;
    }
    scoresEl.innerHTML = hqHtml;
  } else {
    let vpHtml = '';
    gameState.players.forEach(pl => {
      vpHtml += `<span class="px-2 py-0.5 bg-slate-800 border border-slate-700 rounded text-slate-200">${pl.name}: <strong class="text-amber-300">${pl.vp}pt</strong></span>`;
    });
    scoresEl.innerHTML = vpHtml;
  }
}

function cycleAiDifficulty() {
  if (!gameState) return;
  const idx = AI_DIFFICULTY_ORDER.indexOf(gameState.aiDifficulty);
  const next = AI_DIFFICULTY_ORDER[(idx + 1) % AI_DIFFICULTY_ORDER.length];
  gameState.aiDifficulty = next;
  setupState.aiDifficulty = next;

  const sel = document.getElementById('ai-difficulty-select');
  if (sel) sel.value = next;
  const diffDescEl = document.getElementById('ai-difficulty-desc');
  if (diffDescEl) diffDescEl.innerHTML = getAiDiffConfig(next).desc;

  updateHUD();
  const cfg = getAiDiffConfig(next);
  addLog(`🎚️ 敵(AI)の強さを「${cfg.label}」に変更しました。`, 'text-rose-300 font-bold');
  showBanner(`敵(AI)の強さを「${cfg.label}」に変更しました`);
}

function cycleAiSpeed() {
  if (!gameState) return;
  const order = [950, 500, 200, 40];
  const idx = order.indexOf(gameState.aiSpeed);
  const next = order[(idx + 1) % order.length];
  gameState.aiSpeed = next;
  setupState.aiSpeed = next;
  const sel = document.getElementById('ai-speed-select');
  if (sel) sel.value = String(next);
  updateHUD();
  const label = next >= 800 ? '🐢 ゆっくり' : next >= 400 ? '▶️ 標準' : next >= 150 ? '⚡ 高速' : '🚀 超高速';
  showBanner(`敵(AI)のターン速度を「${label}」に変更しました`);
}

function renderInspector() {
  const el = document.getElementById('unit-inspector');
  const u = gameState ? gameState.units.find(x => x.uid === gameState.selectedUid && x.hp > 0) : null;
  if (!u) {
    el.innerHTML = '<div class="text-xs text-slate-400 text-center py-6">盤面の艦船または艦載機をクリックして詳細を表示</div>';
    return;
  }
  const nat = NATIONS[u.nation];
  const owner = gameState.players.find(p => p.id === u.ownerId);
  const maxMove = getEffectiveMove(u);
  const remMove = Math.max(0, maxMove - (u.stepsMoved || 0));
  el.innerHTML = `
    <div class="space-y-2">
      <div class="flex items-center justify-between">
        <div>
          <span class="px-1.5 py-0.5 bg-slate-800 text-amber-300 font-black rounded text-[11px]">${u.type}</span>
          <span class="font-black text-base text-white ml-1">${u.name}</span>
        </div>
        <span class="text-xs font-bold text-slate-300">${nat.name} / ${owner ? owner.name : ''}</span>
      </div>
      <div class="grid grid-cols-4 gap-1.5 bg-slate-950 border border-slate-800 rounded-xl p-2 text-center text-xs">
        <div><div class="text-[10px] text-slate-400">耐久HP</div><div class="font-black text-emerald-400">${u.hp}/${u.maxHp}</div></div>
        <div><div class="text-[10px] text-slate-400">残移動力</div><div class="font-black text-sky-400">${remMove}/${maxMove}</div></div>
        <div><div class="text-[10px] text-slate-400">主砲射程</div><div class="font-black text-amber-300">${getEffectiveRange(u)}</div></div>
        <div><div class="text-[10px] text-slate-400">魚雷残弾</div><div class="font-black text-cyan-300">${u.torp || 0}</div></div>
      </div>
      <div class="text-[11px] bg-slate-950/80 border border-slate-800 rounded-lg p-2 text-slate-300">
        <div class="font-bold text-amber-200">【${u.skillName}】</div>
        <div class="mt-0.5 leading-relaxed">${u.skillDesc}</div>
        ${u.submerged ? '<div class="mt-1 text-cyan-300 font-bold">🫧 現在：潜航中（砲撃・航空攻撃無効 / 奇襲魚雷命中+2）</div>' : ''}
      </div>
    </div>
  `;
}

function renderActionControls() {
  const el = document.getElementById('action-controls');
  const hint = document.getElementById('phase-hint');
  const p = getCurrentPlayer();
  const u = gameState ? gameState.units.find(x => x.uid === gameState.selectedUid && x.hp > 0) : null;

  if (!u || p.isAI || u.ownerId !== p.id || u.acted || u.isFortress) {
    const diffCfg = getAiDiffConfig(gameState ? gameState.aiDifficulty : 'normal');
    hint.textContent = p && p.isAI ? `🤖 AI思考中 (${diffCfg.label})...` : '自軍の未行動ユニットを選択';
    el.innerHTML = `<button onclick="advanceTurn()" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-xs font-bold text-slate-200 rounded-lg">⏭️ 次のユニットへ</button>`;
    return;
  }

  const remMove = Math.max(0, getEffectiveMove(u) - (u.stepsMoved || 0));
  hint.textContent = remMove > 0 ? `水色:前進 / 黄色:1マス後退 (残${remMove}歩)` : '移動完了！攻撃対象をクリック / または待機';
  let btns = '';

  if (u.type === 'CV' || u.shipId === 'jp_ss_i400') {
    btns += `<button onclick="openLaunchModal(gameState.units.find(x=>x.uid==='${u.uid}'))" class="px-3 py-1.5 bg-sky-600 hover:bg-sky-500 text-xs font-black text-white rounded-lg">🛫 ${u.shipId === 'jp_ss_i400' ? '晴嵐発艦' : '艦載機発艦'} (${u.planesRemaining}/${u.maxPlanes})</button>`;
  }

  if (u.type === 'SS') {
    btns += `<button onclick="toggleSubmergeSelectedUnit()" class="px-3 py-1.5 bg-cyan-700 hover:bg-cyan-600 text-xs font-black text-white rounded-lg">${u.submerged ? '⚠️ 浮上する' : '🫧 再潜航する'}</button>`;
  }

  if (!u.isPlane && ((u.nation === 'UK' && !p.ukTurnUsedThisTurn) || u.shipId === 'jp_ca1' || u.shipId === 'fr_ca2')) {
    btns += `<button onclick="extraTurnSelectedUnit(-1)" class="px-2.5 py-1.5 bg-emerald-800 hover:bg-emerald-700 text-xs font-bold text-white rounded-lg">↺ 左旋回</button>`;
    btns += `<button onclick="extraTurnSelectedUnit(1)" class="px-2.5 py-1.5 bg-emerald-800 hover:bg-emerald-700 text-xs font-bold text-white rounded-lg">↻ 右旋回</button>`;
  }

  btns += `<button onclick="waitSelectedUnit()" class="px-3 py-1.5 bg-slate-700 hover:bg-slate-600 text-xs font-bold text-white rounded-lg">⏸️ 行動終了 / 待機</button>`;
  el.innerHTML = btns;
}

function addLog(msg, colorClass = 'text-slate-300') {
  const logEl = document.getElementById('battle-log');
  if (!logEl) return;
  const line = document.createElement('div');
  line.className = `${colorClass} border-b border-slate-900 pb-1 leading-snug`;
  line.textContent = msg;
  logEl.insertBefore(line, logEl.firstChild);
}

function showBanner(msg) {
  const el = document.getElementById('banner-msg');
  el.textContent = msg;
  el.classList.remove('hidden');
  clearTimeout(window._bannerTimer);
  window._bannerTimer = setTimeout(() => el.classList.add('hidden'), 2600);
}

