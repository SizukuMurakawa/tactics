function showGameOverModal(title, desc) {
  const box = document.getElementById('modal-box');
  box.innerHTML = `
    <div class="text-center space-y-4 py-3">
      <div class="text-2xl sm:text-3xl font-black text-amber-300">${title}</div>
      <p class="text-sm text-slate-200 leading-relaxed">${desc}</p>
      <div class="flex justify-center gap-3 pt-2">
        <button onclick="closeModal(); returnToSetup();" class="px-6 py-2.5 bg-sky-600 hover:bg-sky-500 text-white font-black rounded-xl text-sm">⚓ 艦隊編成に戻る</button>
        <button onclick="closeModal();" class="px-5 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold rounded-xl text-sm">盤面を見る</button>
      </div>
    </div>
  `;
  document.getElementById('modal-overlay').classList.remove('hidden');
}

function closeModal() {
  document.getElementById('modal-overlay').classList.add('hidden');
}

function returnToSetup() {
  gameState = null;
  document.getElementById('game-screen').classList.add('hidden');
  document.getElementById('setup-screen').classList.remove('hidden');
  renderSetupPanels();
}

// Initialize setup screen on load
renderSetupPanels();
